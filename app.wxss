}
.stat-row {
  display: flex;
  background: #FFFFFF;
  margin: 20rpx;
  padding: 26rpx 0;
  border-radius: 24rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 34rpx;
