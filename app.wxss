  background: var(--brand-100);
  color: var(--brand);
  font-weight: 600;
}

/* ---------- 列表项 ---------- */
.menu-list {
  background: var(--card);
  margin: 20rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
  box-shadow: var(--sd-1);
