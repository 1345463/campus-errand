}

/* ---------- chip / tag ---------- */
.chip {
  padding: 12rpx 26rpx;
  border-radius: var(--r-pill);
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
  color: var(--t2);
  white-space: nowrap;
}
.chip.active {
  background: var(--brand-100);
  color: var(--brand);
  border-color: var(--brand);
  font-weight: 600;
}
.tag {
  padding: 12rpx 26rpx;
  border-radius: var(--r-pill);
  background: var(--fill);
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
  color: var(--t2);
}
