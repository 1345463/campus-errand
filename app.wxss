/* =========================================================================
   v2 设计系统覆盖层（2026-10-17）
   上面是 v1 的旧定义，这里统一覆盖：白卡 + 浅描边 + 柔和阴影 + 品牌蓝渐变。
   全项目共用这一套，改主题只动「设计令牌」这一块。
   ========================================================================= */

/* ---------- 容器与卡片 ---------- */
.card {
  background: var(--card);
  margin: 20rpx;
  padding: 28rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
  box-shadow: var(--sd-1);
}

.card-elevated {
  box-shadow: var(--sd-2);
}

.order-card {
  background: var(--card);
  margin: 0 20rpx 20rpx;
  padding: 28rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
  box-shadow: var(--sd-1);
}

.task-card {
  padding: 24rpx;
  border-radius: var(--r);
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: var(--sd-1);
  margin-bottom: 20rpx;
}

/* ---------- 顶部主视觉 ---------- */
.hero {
  margin: 20rpx;
  padding: 40rpx 36rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, #2E7CF6 0%, #4FA1FF 60%, #63B3FF 100%);
  color: #FFFFFF;
  box-shadow: var(--sd-brand);
}
.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero-sub {
  font-size: 24rpx;
  margin-top: 14rpx;
  opacity: 0.9;
}

/* ---------- 公告条 ---------- */
.notice-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: var(--brand-50);
  border-bottom: 1rpx solid var(--line);
}
.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  margin-right: 12rpx;
}
.notice-text {
  font-size: 24rpx;
  color: var(--t2);
  flex: 1;
}

/* ---------- 区块标题：左侧品牌竖条 ---------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--brand);
  margin-right: 12rpx;
  vertical-align: -4rpx;
}
.section-more {
  font-size: 24rpx;
  color: var(--t3);
}

/* ---------- 服务宫格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 26rpx;
}
.grid-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  box-shadow: var(--sd-1);
}
.grid-label {
  font-size: 24rpx;
  margin-top: 10rpx;
  color: var(--t2);
}

/* ---------- 快捷入口 ---------- */
.quick-item {
  flex: 1;
  min-width: 0;
  background: var(--fill);
  border-radius: var(--r);
  padding: 24rpx;
  margin-right: 16rpx;
}
