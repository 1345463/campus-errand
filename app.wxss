}

.card {
  background: #FFFFFF;
  margin: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
}
.section-more {
  font-size: 24rpx;
  color: #8A8A8F;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 26rpx;
}
.grid-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.grid-label {
  font-size: 24rpx;
  margin-top: 10rpx;
  color: #3A3D45;
}

.quick-row {
  display: flex;
}
.quick-item {
  flex: 1;
  margin-right: 16rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3E6EB;
}
.quick-item.last {
  margin-right: 0;
}
.quick-title {
  font-size: 28rpx;
  font-weight: 600;
}
.quick-desc {
  font-size: 22rpx;
  color: #8A8A8F;
  margin-top: 8rpx;
}

.task-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3E6EB;
  margin-bottom: 20rpx;
}
.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.task-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}
.reward {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF5A7A;
}
.task-meta {
  font-size: 24rpx;
  color: #8A8A8F;
  margin-top: 10rpx;
}
.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #FFEAF0;
  color: #FF5A7A;
}
.task-btn {
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  background: #FF5A7A;
  color: #FFFFFF;
}

.empty {
  text-align: center;
  color: #A0A3AA;
  font-size: 26rpx;
  padding: 48rpx 0;
}

.field {
  margin-bottom: 30rpx;
}
.field-label {
  font-size: 26rpx;
  color: #5A5D66;
  margin-bottom: 12rpx;
}
.field-star {
  color: #FF5A7A;
}
/* 输入框统一成「白底 + 描边」的实体框。
   原来只有一层 #F7F8FA 底色：放在 #F5F6F8 页面上几乎看不见，
   放进 #FFFFFF 卡片里也只是隐约一片，用户根本分不清哪里能输入、有几项。

   ⚠ 这里**不要**给 input 加 `box-sizing: border-box`，也**不要**加 `width: 100%`：
   小程序的 input 自带一个固定默认高度（约 1.4em）。一旦改成 border-box，
   padding 会从这个高度里扣，content 高度被压成 0 —— 实测描边+padding 刚好占满整个盒子，
   文字上下被裁掉一半（登录页就是这么坏掉的）。
   width:100% 在 content-box 下还会让 padding+border 溢出父容器。
   让 input 保持默认的「块级 + width:auto」，宽高都交给它自己算。 */
.field-input {
  background: #FFFFFF;
  border: 2rpx solid #E3E6EB;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1F2233;
}
.field-textarea {
  background: #FFFFFF;
  border: 2rpx solid #E3E6EB;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1F2233;
  height: 160rpx;
  width: 100%;
  box-sizing: border-box;
}
/* 占位文字统一比正文浅一档，避免和已填内容混淆 */
.field-ph {
  color: #B4B8C0;
}
.hint {
  font-size: 22rpx;
  color: #A0A3AA;
  margin-top: 10rpx;
}

.tags {
