}

.admin-panel {
  margin: 0 20rpx 20rpx;
  padding: 24rpx 28rpx;
}
.admin-panel .hint {
  margin-top: 16rpx;
}

.login-wrap {
  padding: 100rpx 40rpx;
  text-align: center;
}
.login-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.login-desc {
  font-size: 26rpx;
  color: #8A8A8F;
  margin-bottom: 48rpx;
}
.top-gap {
  margin-top: 20rpx;
}
/* ---------- 登录 / 注册表单 ----------
   .login-wrap 是居中的，输入框继承了 text-align:center，
   占位文字「手机号」「密码」看上去就像两个居中标题，加上底色几乎透明，
   整块白底完全分不出是两个输入框。这里把表单区改回左对齐，
   每个字段独立成框、独立标签、拉开间距。
   盒子几何全部交给外层 view（.login-box）控制，input 只负责显示文字 —— 
   view 没有 input 那个默认固定高度，所以 padding / 高度怎么设都不会压扁文字。 */
.login-form {
  text-align: left;
}
.login-item {
  margin-bottom: 28rpx;
}
.login-label {
  font-size: 26rpx;
  color: #5A5D66;
  margin-bottom: 12rpx;
  padding-left: 6rpx;
}
.login-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3E6EB;
  border-radius: 18rpx;
  box-sizing: border-box;
}
.login-box.focused {
  border-color: #FF5A7A;
  background: #FFF8FA;
}
.login-input {
  flex: 1;
  /* input 自身已无 padding / border，width:100% 不会再溢出父容器，
     万一渲染器没把它当 flex item，它也照样能撑满整行 */
  width: 100%;
  min-width: 0;
  font-size: 30rpx;
  line-height: normal;
  color: #1F2233;
  text-align: left;
  background: transparent;
  border: 0;
  padding: 0;
}
.login-ph {
  color: #B4B8C0;
  font-size: 28rpx;
}
.login-error {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: #FFF3F5;
  border: 2rpx solid #FFD3DC;
  color: #D33A5C;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
}
.code-row {
  display: flex;
  align-items: stretch;
}
.code-box {
  flex: 1;
  margin-right: 16rpx;
}
.code-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background: #FFEAF0;
  color: #FF5A7A;
  font-size: 26rpx;
  white-space: nowrap;
}
.code-btn.disabled {
  background: #F2F3F5;
  color: #A0A3AA;
}
.switch-line {
  text-align: center;
  font-size: 26rpx;
  color: #8A8A8F;
  margin-top: 30rpx;
}
.link {
  color: #FF5A7A;
}
.divider {
  text-align: center;
  color: #C0C3CA;
  font-size: 24rpx;
  margin: 50rpx 0 30rpx;
  position: relative;
}

/* 楼栋 / 楼层 / 宿舍号 三级选择 */
.room-picker {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #E3E6EB;
  border-radius: 16rpx;
  padding: 20rpx;
  justify-content: space-between;
}
.room-text {
  font-size: 28rpx;
  flex: 1;
}
.room-placeholder {
  color: #A0A3AA;
}
.room-arrow {
  color: #C0C3CA;
  font-size: 26rpx;
}
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}
.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  padding-bottom: 20rpx;
}
.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #F2F3F5;
}
.picker-cancel {
  font-size: 28rpx;
  color: #8A8A8F;
}
.picker-title {
  font-size: 30rpx;
  font-weight: 600;
}
.picker-done {
  font-size: 28rpx;
  color: #FF5A7A;
  font-weight: 600;
}
.picker-body {
  max-height: 520rpx;
}
.picker-col {
  height: 440rpx;
}
.picker-cell {
  text-align: center;
  font-size: 30rpx;
  line-height: 88rpx;
  color: #3A3D45;
}

.rental-item {
  display: flex;
  align-items: center;
  padding: 26rpx;
  background: #FFFFFF;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
}
.rental-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 20rpx;
  background: #F3F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.rental-info {
  flex: 1;
  margin-left: 24rpx;
}
.rental-name {
  font-size: 30rpx;
  font-weight: 600;
}
.rental-spec {
  font-size: 24rpx;
  color: #8A8A8F;
  margin-top: 8rpx;
}
.rental-price {
  color: #FF5A7A;
  font-size: 34rpx;
  font-weight: 600;
}
.rental-unit {
  font-size: 22rpx;
  color: #8A8A8F;
}

.detail-row {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}
.detail-row.last {
  border-bottom: none;
}
.detail-label {
  width: 180rpx;
  color: #8A8A8F;
  font-size: 26rpx;
}
.detail-value {
  flex: 1;
  font-size: 28rpx;
  word-break: break-all;
}
.hidden-tip {
  color: #A0A3AA;
  font-size: 25rpx;
}
.img-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.img-thumb {
  width: 160rpx;
  height: 160rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
}

/* ===== 管理后台：接单员审核 ===== */
.btn-danger {
  background: #F2F3F5;
  color: #E5484D;
  text-align: center;
  padding: 26rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-row .half {
  flex: 1;
  margin-right: 0;
}
.btn-row .half:first-child {
  margin-right: 16rpx;
}
.btn-row {
  margin-top: 20rpx;
}
.apply-card {
  padding: 28rpx;
}
.apply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #F2F3F5;
}
.apply-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2126;
}
.status-text {
  font-size: 24rpx;
}
.status-approved {
  color: #22A06B;
}
.status-rejected {
  color: #E5484D;
}
.doc-row {
  display: flex;
  padding-top: 22rpx;
}
.doc-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #FF5A7A;
  background: #FFEAF0;
  padding: 18rpx 0;
  border-radius: 999rpx;
}
.doc-btn:first-child {
  margin-right: 16rpx;
}
.note-box {
  margin-top: 20rpx;
}.note-input {
  width: 100%;
  background: #FFFFFF;
  border: 2rpx solid #E3E6EB;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #1F2233;
  min-height: 120rpx;
  box-sizing: border-box;
}
.img-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.img-preview {
  width: 100%;
}
.img-tip {
  color: #FFFFFF;
  font-size: 26rpx;
  margin-top: 32rpx;
}

/* ===== 身份切换 / 积分钱包 ===== */
.role-switch {
  display: flex;
  background: #F2F3F5;
  border-radius: 999rpx;
  padding: 6rpx;
}
.role-opt {
  padding: 12rpx 26rpx;
  font-size: 24rpx;
  color: #8A8A8F;
  border-radius: 999rpx;
}
.role-opt.on {
  background: #FF5A7A;
  color: #FFFFFF;
  font-weight: 600;
}
.stat-arrow {
  color: #C6C8CE;
  margin-left: 6rpx;
}
.btn-disabled {
  background: #E9EAED;
  color: #A0A3AA;
  text-align: center;
  padding: 26rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}

/* ===== 头像与用户名（第四章）===== */
/* 点头像区即可改资料：整块可点，右侧的身份切换不受影响 */
.profile-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.profile-main .profile-info {
  min-width: 0;
}
.avatar-tap {
  position: relative;
  overflow: visible;
  flex: none;
}
.avatar-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #F2F3F5;
}
/* 头像右下角的小角标，提示这里可以点 */
.avatar-edit {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #FF5A7A;
  font-size: 20rpx;
  text-align: center;
  border: 2rpx solid #FF5A7A;
  box-sizing: border-box;
}

/* 注册表单里的必填标记 */
.required-mark {
  color: #FF5A7A;
  margin-left: 6rpx;
  font-size: 26rpx;
}
.login-name-hint {
  margin: 4rpx 0 12rpx;
}

