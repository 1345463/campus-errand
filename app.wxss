page {
  background: #F5F6F8;
  color: #1F2229;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding-bottom: 60rpx;
}

.login-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #FFF4E5;
}
.login-tip-text {
  font-size: 24rpx;
  color: #8A5A1A;
  flex: 1;
}
.login-tip-btn {
  font-size: 24rpx;
  color: #FF5A7A;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.notice-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFF4E5;
}
.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
