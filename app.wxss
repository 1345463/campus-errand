page {
  background: var(--bg);
  color: var(--t1);
  /* ===== v2 设计令牌 =====
     校园蓝 = 校园/可靠；活力橙 = 跑腿/速度。改这一个块就能整体换肤。 */
  --brand: #2E7CF6;
  --brand-600: #1D5FD0;
  --brand-100: #E4EEFF;
  --brand-50: #F2F7FF;
  --accent: #FF8A3D;
  --accent-100: #FFF0E4;
  --success: #16A34A;
  --success-100: #E6F6EC;
  --warn: #F59E0B;
  --warn-100: #FFF5E3;
  --danger: #EF4444;
  --danger-100: #FDECEC;
  --bg: #F4F6FB;
  --card: #FFFFFF;
  --fill: #F1F4FA;
  --line: #E6EAF2;
  --t1: #131A2A;
  --t2: #5A6478;
  --t3: #98A2B3;
  --r-sm: 12rpx;
  --r: 20rpx;
  --r-lg: 28rpx;
  --r-pill: 999rpx;
  --sd-1: 0 2rpx 10rpx rgba(19, 26, 42, 0.05);
  --sd-2: 0 8rpx 28rpx rgba(19, 26, 42, 0.08);
  --sd-brand: 0 10rpx 26rpx rgba(46, 124, 246, 0.28);

  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding-bottom: 60rpx;
}

.login-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: var(--warn-100);
}
.login-tip-text {
  font-size: 24rpx;
  color: #8A5A1A;
  flex: 1;
}
.login-tip-btn {
  font-size: 24rpx;
  color: var(--brand);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.notice-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--warn-100);
}
.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--warn);
  margin-right: 12rpx;
}
.notice-text {
  font-size: 24rpx;
  color: #8A5A1A;
  flex: 1;
}

.hero {
  margin: 20rpx;
  padding: 36rpx;
  border-radius: 24rpx;
  background: var(--brand);
  color: #FFFFFF;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 600;
}
.hero-sub {
  font-size: 24rpx;
  margin-top: 14rpx;
  opacity: 0.92;
}

.card {
  background: #FFFFFF;
  margin: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
}
.section-more {
  font-size: 24rpx;
  color: var(--t3);
}

.grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 26rpx;
}
.grid-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.grid-label {
  font-size: 24rpx;
  margin-top: 10rpx;
  color: var(--t1);
}

.quick-row {
  display: flex;
}
.quick-item {
  flex: 1;
  margin-right: 16rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
}
.quick-item.last {
  margin-right: 0;
}
.quick-title {
  font-size: 28rpx;
  font-weight: 600;
}
.quick-desc {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 8rpx;
}

.task-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  margin-bottom: 20rpx;
}
.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.task-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}
.reward {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
}
.task-meta {
  font-size: 24rpx;
  color: var(--t3);
  margin-top: 10rpx;
}
.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-100);
  color: var(--brand);
}
.task-btn {
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #FFFFFF;
}

.empty {
  text-align: center;
  color: var(--t3);
  font-size: 26rpx;
  padding: 48rpx 0;
}

.field {
  margin-bottom: 30rpx;
}
.field-label {
  font-size: 26rpx;
  color: var(--t2);
  margin-bottom: 12rpx;
}
.field-star {
  color: var(--brand);
}
/* 输入框统一成「白底 + 描边」的实体框。
   原来只有一层 var(--fill) 底色：放在 var(--bg) 页面上几乎看不见，
   放进 #FFFFFF 卡片里也只是隐约一片，用户根本分不清哪里能输入、有几项。

   ⚠ 这里**不要**给 input 加 `box-sizing: border-box`，也**不要**加 `width: 100%`：
   小程序的 input 自带一个固定默认高度（约 1.4em）。一旦改成 border-box，
   padding 会从这个高度里扣，content 高度被压成 0 —— 实测描边+padding 刚好占满整个盒子，
   文字上下被裁掉一半（登录页就是这么坏掉的）。
   width:100% 在 content-box 下还会让 padding+border 溢出父容器。
   让 input 保持默认的「块级 + width:auto」，宽高都交给它自己算。 */
.field-input {
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--t1);
}
.field-textarea {
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--t1);
  height: 160rpx;
  width: 100%;
  box-sizing: border-box;
}
/* 占位文字统一比正文浅一档，避免和已填内容混淆 */
.field-ph {
  color: #B4B8C0;
}
.hint {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 10rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}
.tag {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: var(--fill);
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
  color: var(--t2);
}
.tag.active {
  background: var(--brand-100);
  color: var(--brand);
}
.gender-row {
  display: flex;
}

.uploader {
  display: flex;
  flex-wrap: wrap;
}
.upload-item {
  width: 150rpx;
  height: 150rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  background: var(--fill);
  position: relative;
}
.upload-item image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
}
.upload-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 24rpx;
  text-align: center;
  line-height: 40rpx;
}
.upload-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: var(--t3);
}

.footer-bar {
  padding: 20rpx 24rpx 40rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #EFEFEF;
}
.btn-primary {
  background: var(--brand);
  color: #FFFFFF;
  text-align: center;
  padding: 26rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-ghost {
  background: var(--fill);
  color: var(--t2);
  text-align: center;
  padding: 26rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.btn-row {
  display: flex;
}
.btn-row .btn-primary {
  flex: 1;
  margin-right: 16rpx;
}
.btn-row .btn-ghost {
  flex: 1;
}
.disabled {
  opacity: 0.5;
}
/* 二次确认态：和默认主按钮明显区分，避免用户以为没点到 */
.btn-armed {
  background: #FF8A3D;
}
.err-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 20rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #FFF1F3;
  border: 1rpx solid #FFD5DD;
}
.err-text {
  flex: 1;
  color: #D9304E;
  font-size: 26rpx;
  line-height: 1.5;
}
.err-retry {
  flex: none;
  margin-left: 20rpx;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}
.tip-bar {
  margin: 20rpx 20rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #EAF7EF;
  border: 1rpx solid #C8EBD5;
}
.tip-text {
  color: #1E8A4B;
  font-size: 26rpx;
}
.tool-row {
  display: flex;
  padding: 20rpx 20rpx 0;
}
.settle-text {
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.6;
}
.settle-rule {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--t3);
  line-height: 1.6;
}
.settle-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.settle-feedback {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: var(--warn-100);
  color: var(--warn);
  font-size: 25rpx;
  line-height: 1.6;
}
.feedback-box {
  margin-top: 20rpx;
}
.field-area {
  width: 100%;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: var(--t1);
  min-height: 120rpx;
}
.top-gap-sm {
  margin-top: 14rpx;
}
.mine-link {
  margin-left: 12rpx;
  color: var(--brand);
  font-size: 24rpx;
}
.agree-line {
  font-size: 26rpx;
  color: var(--t1);
  line-height: 1.8;
  margin-bottom: 12rpx;
}
.agree-note {
  background: var(--warn-100);
  border: 1rpx solid var(--warn-100);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  color: var(--warn);
  font-size: 25rpx;
  line-height: 1.7;
}
.agree-row {
  display: flex;
  align-items: flex-start;
  padding-bottom: 20rpx;
}
.agree-box {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--line);
  margin-right: 14rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.agree-box.checked {
  background: var(--brand);
  border-color: var(--brand);
}
.agree-tick {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1;
}
.agree-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--t1);
  line-height: 1.6;
}
.field-tip {
  background: var(--warn-100);
  border: 1rpx solid var(--warn-100);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin: 10rpx 0 14rpx;
  color: var(--warn);
  font-size: 24rpx;
  line-height: 1.7;
}
/* 违规词：发布页顶部横幅 + 字段下方的红字 */
.mod-bar {
  margin: 20rpx 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #FFEBEC;
  border: 1rpx solid var(--danger-100);
}
.mod-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-600);
  margin-bottom: 8rpx;
}
.mod-text {
  display: block;
  font-size: 24rpx;
  color: var(--brand-600);
  line-height: 1.6;
}
.mod-sub {
  display: block;
  font-size: 22rpx;
  color: #A85563;
  line-height: 1.6;
  margin-top: 8rpx;
}
.mod-field-error {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF0F1;
  border: 1rpx solid var(--danger-100);
  color: var(--brand-600);
  font-size: 24rpx;
  line-height: 1.6;
}
.login-agree {
  padding-top: 20rpx;
  text-align: left;
}
.btn-block {
  margin: 0 0 16rpx;
}

.addr-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--fill);
}
.addr-item:last-child {
  border-bottom: none;
}
.addr-main {
  flex: 1;
}
.addr-title {
  font-size: 28rpx;
}
.addr-sub {
  font-size: 24rpx;
  color: var(--t3);
  margin-top: 8rpx;
}
.addr-use {
  font-size: 24rpx;
  color: var(--brand);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--brand-100);
}
.addr-del {
  font-size: 24rpx;
  color: var(--t3);
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--fill);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 20rpx 0;
}
.chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
  color: var(--t2);
  /* 关键：chip 是行内 text 时必须禁止内部换行，
     否则「7 天」会在数字和「天」之间断开，且行内元素的 padding
     不撑高行盒 —— 背景圆角就会和上一行文字叠在一起。 */
  white-space: nowrap;
}
.chip.active {
  background: var(--brand-100);
  color: var(--brand);
}
/* chip 排布容器：必须显式 flex 换行。
   直接把一串行内 text 塞进 .detail-value（block）里时，
   它们按纯文本排版，撑不开盒模型，选中态背景就会糊成一片。 */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 4rpx;
}
/* 表单里的常用地点快捷标签：必须看起来「可点」，否则用户以为是一行普通说明 */
.field-chips {
  margin-top: 16rpx;
}
.chip-shortcut {
  border: 1rpx solid #E6E9F0;
  margin-bottom: 12rpx;
}
.chip-shortcut.active {
  border-color: var(--brand-100);
}
/* 订单卡片底部操作：删除 / 恢复 */
.card-actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--fill);
}
.link-danger {
  color: var(--brand-600);
  font-size: 24rpx;
}
.link-danger.strong {
  font-weight: 600;
}
.link-ghost {
  color: var(--t3);
  font-size: 24rpx;
  margin-left: 24rpx;
}
.link-primary {
  color: var(--brand);
  font-size: 24rpx;
}
.hidden-foot {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}
.order-card.muted {
  opacity: 0.68;
}

.rent-total {
  font-size: 24rpx;
  color: var(--t3);
  line-height: 1.6;
}
.order-card {
  background: #FFFFFF;
  margin: 0 20rpx 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
}
.status-pending {
  color: var(--warn);
}
.status-accepted {
  color: #3B82F6;
}
.status-done {
  color: var(--success);
}
.status-canceled {
  color: var(--t3);
}

.profile-head {
  margin: 20rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  background: var(--brand);
  color: #FFFFFF;
  display: flex;
  align-items: center;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: var(--brand);
  font-size: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}
.profile-info {
  margin-left: 24rpx;
  flex: 1;
}
.uname {
  font-size: 34rpx;
  font-weight: 600;
}
.uid {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}
.role-tag {
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
}
.stat-row {
  display: flex;
  background: #FFFFFF;
  margin: 20rpx;
  padding: 26rpx 0;
  border-radius: 24rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 34rpx;
  font-weight: 600;
}
.stat-label {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}
.menu-list {
  background: #FFFFFF;
  margin: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--fill);
}
.menu-item.last {
  border-bottom: none;
}
.menu-icon {
  font-size: 34rpx;
  width: 60rpx;
}
.menu-label {
  flex: 1;
  font-size: 28rpx;
}
.menu-value {
  color: var(--t3);
  font-size: 26rpx;
  margin-right: 12rpx;
}
.menu-arrow {
  color: var(--line);
  font-size: 26rpx;
}

.admin-panel {
  margin: 0 20rpx 20rpx;
  padding: 24rpx 28rpx;
}
.admin-panel .hint {
  margin-top: 16rpx;
}

.login-wrap {
  padding: 100rpx 40rpx;
  text-align: center;
}
.login-title {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.login-desc {
  font-size: 26rpx;
  color: var(--t3);
  margin-bottom: 48rpx;
}
.top-gap {
  margin-top: 20rpx;
}
/* ---------- 登录 / 注册表单 ----------
   .login-wrap 是居中的，输入框继承了 text-align:center，
   占位文字「手机号」「密码」看上去就像两个居中标题，加上底色几乎透明，
   整块白底完全分不出是两个输入框。这里把表单区改回左对齐，
   每个字段独立成框、独立标签、拉开间距。
   盒子几何全部交给外层 view（.login-box）控制，input 只负责显示文字 —— 
   view 没有 input 那个默认固定高度，所以 padding / 高度怎么设都不会压扁文字。 */
.login-form {
  text-align: left;
}
.login-item {
  margin-bottom: 28rpx;
}
.login-label {
  font-size: 26rpx;
  color: var(--t2);
  margin-bottom: 12rpx;
  padding-left: 6rpx;
}
.login-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  box-sizing: border-box;
}
.login-box.focused {
  border-color: var(--brand);
  background: #FFF8FA;
}
.login-input {
  flex: 1;
  /* input 自身已无 padding / border，width:100% 不会再溢出父容器，
     万一渲染器没把它当 flex item，它也照样能撑满整行 */
  width: 100%;
  min-width: 0;
  font-size: 30rpx;
  line-height: normal;
  color: var(--t1);
  text-align: left;
  background: transparent;
  border: 0;
  padding: 0;
}
.login-ph {
  color: #B4B8C0;
  font-size: 28rpx;
}
.login-error {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
