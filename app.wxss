  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.menu-item.last {
  border-bottom: none;
}
.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--t1);
}
.menu-value {
  font-size: 26rpx;
  color: var(--t3);
}
.menu-arrow {
  color: var(--t3);
  font-size: 26rpx;
  margin-left: 12rpx;
}

/* ---------- 统计栏 ---------- */
.stat-row {
  display: flex;
  background: var(--card);
  margin: 20rpx;
  padding: 26rpx 0;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
  box-shadow: var(--sd-1);
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
}
.stat-label {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

/* ---------- 个人中心头部 ---------- */
.profile-head {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #2E7CF6 0%, #4FA1FF 60%, #63B3FF 100%);
  color: #FFFFFF;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  overflow: hidden;
}
.uname {
  font-size: 34rpx;
  font-weight: 600;
}

/* ---------- 空态 / 提示 ---------- */
.empty {
  text-align: center;
  color: var(--t3);
  font-size: 26rpx;
  padding: 64rpx 0;
}
.err-bar, .tip-bar {
  margin: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r);
  background: var(--danger-100);
  color: var(--danger);
  font-size: 24rpx;
}
.tip-bar {
  background: var(--brand-50);
  color: var(--brand);
}

/* ---------- 状态圆标（pill 系列，新增可复用组件） ---------- */
.pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  line-height: 1.6;
}
.pill-brand { background: var(--brand-100); color: var(--brand); }
.pill-accent { background: var(--accent-100); color: var(--accent); }
.pill-success { background: var(--success-100); color: var(--success); }
.pill-warn { background: var(--warn-100); color: var(--warn); }
.pill-danger { background: var(--danger-100); color: var(--danger); }
.pill-gray { background: var(--fill); color: var(--t3); }

/* ---------- 小工具类 ---------- */
.text-brand { color: var(--brand); }
.text-danger { color: var(--danger); }
.text-muted { color: var(--t3); }
.shadow-1 { box-shadow: var(--sd-1); }
.shadow-2 { box-shadow: var(--sd-2); }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.divider-line { height: 1rpx; background: var(--line); margin: 20rpx 0; }

/* ---------- 底部操作条（保持静态定位，页面自己决定要不要吸底） ---------- */
.footer-bar {
  padding: 20rpx 24rpx 40rpx;
  background: var(--card);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -4rpx 16rpx rgba(19, 26, 42, 0.05);
}

/* ---------- 提示文字 / 辅助 ---------- */
.hint {
  font-size: 24rpx;
  color: var(--t3);
}

/* ---------- 顶部间距 ---------- */
.top-gap { margin-top: 24rpx; }
.top-gap-sm { margin-top: 12rpx; }

/* =========================================================================
   v3 · 动效层 Motion System
   -------------------------------------------------------------------------
   目标：让校园跑腿有「微信小程序该有的手感」—— 入场有编排、点击有回弹、
   等待有骨架、滚动有反馈、关键动作有震动。

   三条硬约束（改动画前先读）：
   1) 只动 transform / opacity / background-position —— 走合成层不掉帧；
      不要动画 width/height/top/left，列表页会肉眼可见地卡。
   2) 时长压在 180~520ms；弹性回弹统一用 --ease-spring。
   3) 用户在「我的 → 减弱动效」里关掉后，页面根节点挂 .reduced-motion，
      下面这一组 !important 会把全部循环动画停掉（入场动画仍保留，只去掉位移）。

   用法：
      <view class="anim anim-up" style="--d:120ms">…</view>   单项延迟
      <view class="stagger">…</view>                          子项自动阶梯延迟
      <view hover-class="press">…</view>                      按压回弹
   ========================================================================= */

page {
  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);
  --ease-spring: cubic-bezier(0.34, 1.42, 0.64, 1);
  --ease-in-out: cubic-bezier(0.42, 0, 0.58, 1);
  --dur-fast: 180ms;
  --dur: 320ms;
  --dur-slow: 520ms;
}

/* ---------- 关键帧 ---------- */
@keyframes mp-fade-up { from { opacity: 0; transform: translateY(32rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes mp-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes mp-pop-in { 0% { opacity: 0; transform: scale(0.86); } 60% { opacity: 1; transform: scale(1.04); } 100% { opacity: 1; transform: scale(1); } }
@keyframes mp-slide-down { from { opacity: 0; transform: translateY(-40rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes mp-slide-left { from { opacity: 0; transform: translateX(40rpx); } to { opacity: 1; transform: translateX(0); } }
@keyframes mp-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }
@keyframes mp-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
@keyframes mp-shimmer { from { background-position: -360rpx 0; } to { background-position: 360rpx 0; } }
@keyframes mp-sweep { 0% { transform: translateX(-140%) skewX(-18deg); } 100% { transform: translateX(260%) skewX(-18deg); } }
@keyframes mp-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes mp-grad-shift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

/* ---------- 入场编排 ---------- */
.anim {
  animation-duration: var(--dur);
  animation-timing-function: var(--ease-out);
  animation-fill-mode: both;
  animation-delay: var(--d, 0ms);
}
.anim-up { animation-name: mp-fade-up; }
.anim-fade { animation-name: mp-fade-in; }
.anim-pop { animation-name: mp-pop-in; animation-timing-function: var(--ease-spring); }
.anim-down { animation-name: mp-slide-down; }
.anim-left { animation-name: mp-slide-left; }
.anim-slow { animation-duration: var(--dur-slow); }
.anim-fast { animation-duration: var(--dur-fast); }

/* 容器挂 .stagger，子项自动获得阶梯延迟（第 11 项起统一封顶，避免长列表越等越久） */
.stagger > *:nth-child(1) { --d: 0ms; }
.stagger > *:nth-child(2) { --d: 45ms; }
.stagger > *:nth-child(3) { --d: 90ms; }
.stagger > *:nth-child(4) { --d: 135ms; }
.stagger > *:nth-child(5) { --d: 180ms; }
.stagger > *:nth-child(6) { --d: 225ms; }
.stagger > *:nth-child(7) { --d: 270ms; }
.stagger > *:nth-child(8) { --d: 315ms; }
.stagger > *:nth-child(9) { --d: 360ms; }
.stagger > *:nth-child(10) { --d: 405ms; }
.stagger > *:nth-child(n + 11) { --d: 450ms; }

/* ---------- 按压反馈（hover-class 用）---------- */
.pressable { transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) linear; }
.press { transform: scale(0.955); opacity: 0.82; }
.press-strong { transform: scale(0.9); opacity: 0.75; }
.press-lift { transform: translateY(-4rpx); box-shadow: var(--sd-2); }

/* ---------- 骨架屏 ---------- */
.sk {
  background: linear-gradient(90deg, #EDF1F8 0%, #F8FAFD 45%, #EDF1F8 90%);
  background-size: 360rpx 100%;
  animation: mp-shimmer 1.25s linear infinite;
  border-radius: 10rpx;
}
.sk-card {
  background: var(--card);
  margin: 0 20rpx 20rpx;
  padding: 28rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
  box-shadow: var(--sd-1);
}
.sk-title { height: 32rpx; width: 62%; margin-bottom: 18rpx; }
.sk-line { height: 24rpx; margin-bottom: 14rpx; }
.sk-line.short { width: 44%; }
.sk-line.mid { width: 78%; }
.sk-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; }
.sk-block { height: 200rpx; border-radius: var(--r-lg); }

/* ---------- 悬浮操作按钮 FAB ---------- */
.fab {
  position: fixed;
  right: 30rpx;
  bottom: 168rpx; /* 让开 tabBar（约 100rpx）+ 安全区 */
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2E7CF6 0%, #4FA1FF 100%);
  box-shadow: 0 12rpx 32rpx rgba(46, 124, 246, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 52rpx;
  z-index: 80;
}
.fab-label {
  font-size: 22rpx;
  margin-left: 4rpx;
  font-weight: 600;
}
.fab-breathe { animation: mp-breathe 2.8s var(--ease-in-out) infinite; }
.fab-mini {
  position: fixed;
  right: 34rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid var(--line);
  box-shadow: var(--sd-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--t2);
  z-index: 79;
}
.fab-mini.to-top { bottom: 288rpx; }

/* ---------- 流光按钮（主 CTA 循环扫光）---------- */
.btn-shine { position: relative; overflow: hidden; }
.btn-shine::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 36%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0));
  animation: mp-sweep 3.2s var(--ease-in-out) infinite;
  pointer-events: none;
}

/* ---------- 渐变流动（头部主视觉）---------- */
.hero-flow {
  background-size: 220% 220%;
  animation: mp-grad-shift 9s ease-in-out infinite;
}

/* ---------- 吸顶栏（滚动联动阴影由页面加 .stuck 控制）---------- */
.sticky-bar {
  position: sticky;
  top: 0;
  z-index: 30;
  transition: box-shadow var(--dur) var(--ease-out);
}
.sticky-bar.stuck { box-shadow: 0 8rpx 24rpx rgba(19, 26, 42, 0.08); }

/* ---------- 自定义下拉刷新（scroll-view refresher）---------- */
.refresh-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.refresh-spin {
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line);
  border-top-color: var(--brand);
  animation: mp-spin 0.8s linear infinite;
}

/* ---------- 自定义导航栏 ---------- */
.nav-bar { position: fixed; left: 0; right: 0; top: 0; z-index: 100; }
.nav-bar-bg { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.nav-bar-body {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  max-width: 340rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}
.nav-back-arrow { font-size: 34rpx; font-weight: 600; }

/* ---------- 页面命名空间（verify-mp.js 会对账 WXML 里用到的 class）---------- */
.home, .mine { min-height: 100vh; }
.hall, .orders { padding-bottom: 40rpx; }

/* ---------- 减弱动效：关掉一切循环动画，入场动画去掉位移 ---------- */
.reduced-motion .sk,
.reduced-motion .fab-breathe,
.reduced-motion .btn-shine::after,
.reduced-motion .hero-flow,
.reduced-motion .refresh-spin,
.reduced-motion .anim-float { animation: none !important; }
.reduced-motion .sk { background: var(--fill); }
.reduced-motion .anim-up,
.reduced-motion .anim-down,
.reduced-motion .anim-left { animation-name: mp-fade-in !important; }
.reduced-motion .anim-pop { animation-name: mp-fade-in !important; }

/* ---------- 底部半屏面板（小程序最典型的轻交互）---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(19, 26, 42, 0.45);
  z-index: 200;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 24rpx 40rpx;
  transform: translateY(102%);
  transition: transform var(--dur) var(--ease-out);
  box-shadow: 0 -12rpx 40rpx rgba(19, 26, 42, 0.14);
}
.sheet.open { transform: translateY(0); }
/* 顶部的「小把手」，暗示这是一个可以往下滑走的面板 */
.sheet-grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 8rpx auto 20rpx;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
}
.sheet-sub {
  font-size: 24rpx;
  color: var(--t3);
  margin-bottom: 24rpx;
}
.sheet-grid {
  display: flex;
  flex-wrap: wrap;
}
.sheet-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}
.sheet-cell-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: var(--sd-1);
}
.sheet-cell-label {
  font-size: 24rpx;
  color: var(--t2);
  margin-top: 10rpx;
}
/* 安全区：iPhone X 以后的底部横条，不留出会被系统手势条压住 */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
