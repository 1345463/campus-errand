  color: var(--t3);
  margin-top: 8rpx;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #2E7CF6 0%, #4FA1FF 100%);
  color: #FFFFFF;
  text-align: center;
  padding: 26rpx;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--sd-brand);
}
.btn-accent {
  background: linear-gradient(135deg, #FF8A3D 0%, #FFA45F 100%);
  color: #FFFFFF;
  text-align: center;
  padding: 26rpx;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 26rpx rgba(255, 138, 61, 0.28);
}
.btn-ghost {
