.filter-row {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 20rpx 0;
}
.chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
  color: #5A5D66;
  /* 关键：chip 是行内 text 时必须禁止内部换行，
     否则「7 天」会在数字和「天」之间断开，且行内元素的 padding
     不撑高行盒 —— 背景圆角就会和上一行文字叠在一起。 */
  white-space: nowrap;
}
.chip.active {
  background: #FFEAF0;
  color: #FF5A7A;
}
/* chip 排布容器：必须显式 flex 换行。
   直接把一串行内 text 塞进 .detail-value（block）里时，
   它们按纯文本排版，撑不开盒模型，选中态背景就会糊成一片。 */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 4rpx;
}
/* 表单里的常用地点快捷标签：必须看起来「可点」，否则用户以为是一行普通说明 */
.field-chips {
