}
.code-btn.disabled {
  background: var(--fill);
  color: var(--t3);
}
.switch-line {
  text-align: center;
  font-size: 26rpx;
  color: var(--t3);
  margin-top: 30rpx;
}
.link {
  color: var(--brand);
}
.divider {
  text-align: center;
  color: var(--line);
  font-size: 24rpx;
  margin: 50rpx 0 30rpx;
  position: relative;
}

/* 楼栋 / 楼层 / 宿舍号 三级选择 */
.room-picker {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx;
  justify-content: space-between;
}
.room-text {
  font-size: 28rpx;
  flex: 1;
}
.room-placeholder {
  color: var(--t3);
}
.room-arrow {
  color: var(--line);
  font-size: 26rpx;
}
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}
.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  padding-bottom: 20rpx;
}
.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid var(--fill);
}
.picker-cancel {
  font-size: 28rpx;
  color: var(--t3);
}
.picker-title {
  font-size: 30rpx;
  font-weight: 600;
}
.picker-done {
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 600;
}
.picker-body {
  max-height: 520rpx;
}
.picker-col {
  height: 440rpx;
}
.picker-cell {
  text-align: center;
  font-size: 30rpx;
  line-height: 88rpx;
  color: var(--t1);
}

.rental-item {
  display: flex;
  align-items: center;
  padding: 26rpx;
  background: #FFFFFF;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
}
.rental-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 20rpx;
  background: #F3F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}
.rental-info {
  flex: 1;
  margin-left: 24rpx;
}
.rental-name {
  font-size: 30rpx;
  font-weight: 600;
}
.rental-spec {
  font-size: 24rpx;
  color: var(--t3);
  margin-top: 8rpx;
}
.rental-price {
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
}
.rental-unit {
  font-size: 22rpx;
  color: var(--t3);
}

.detail-row {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--fill);
}
.detail-row.last {
  border-bottom: none;
}
.detail-label {
  width: 180rpx;
  color: var(--t3);
  font-size: 26rpx;
}
.detail-value {
  flex: 1;
  font-size: 28rpx;
  word-break: break-all;
}
.hidden-tip {
  color: var(--t3);
  font-size: 25rpx;
}
.img-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.img-thumb {
  width: 160rpx;
  height: 160rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
}

/* ===== 管理后台：接单员审核 ===== */
.btn-danger {
  background: var(--fill);
  color: var(--danger);
  text-align: center;
  padding: 26rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-row .half {
  flex: 1;
  margin-right: 0;
}
.btn-row .half:first-child {
  margin-right: 16rpx;
}
.btn-row {
  margin-top: 20rpx;
}
.apply-card {
  padding: 28rpx;
}
.apply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--fill);
}
.apply-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}
.status-text {
