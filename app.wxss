  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
}
.code-row {
  display: flex;
  align-items: stretch;
}
.code-box {
  flex: 1;
  margin-right: 16rpx;
}
.code-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx;
  border-radius: 18rpx;
