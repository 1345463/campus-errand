<view class="rp-wrap">
  <view class="room-picker" bindtap="open">
    <text class="room-text {{value ? '' : 'room-placeholder'}}">{{value || placeholder}}</text>
    <text class="room-arrow">▾</text>
  </view>

  <view wx:if="{{visible}}" class="picker-mask" bindtap="close" catchtouchmove="noop"></view>
  <!-- 面板上不要挂 catchtouchmove：它会拦掉三列 scroll-view 的 touchmove，导致完全滑不动 -->
  <view wx:if="{{visible}}" class="picker-panel">
    <view class="picker-head">
      <text class="picker-cancel" bindtap="close">取消</text>
      <text class="picker-title">楼栋 / 楼层 / 宿舍号</text>
      <text class="picker-done" bindtap="confirm">确定</text>
    </view>

    <view class="picker-col-head">
      <text class="picker-col-title">楼栋</text>
      <text class="picker-col-title">楼层</text>
      <text class="picker-col-title">宿舍号</text>
    </view>
    <view class="picker-cols">
      <scroll-view
        class="picker-col"
        scroll-y="{{true}}"
        show-scrollbar="{{true}}"
        enhanced="{{false}}"
        scroll-into-view="c0-{{idx[0]}}"
        style="height:{{colHeight}}rpx"
      >
        <view
          id="c0-{{index}}"
          class="picker-cell {{idx[0] === index ? 'active' : ''}} {{item === '其他' ? 'cell-other' : ''}}"
          wx:for="{{buildings}}"
          wx:key="*this"
          data-col="0"
          data-i="{{index}}"
          bindtap="pick"
        >{{item}}</view>
      </scroll-view>
      <scroll-view
        class="picker-col"
        scroll-y="{{true}}"
        show-scrollbar="{{true}}"
        enhanced="{{false}}"
        scroll-into-view="c1-{{idx[1]}}"
        style="height:{{colHeight}}rpx"
      >
        <view
          id="c1-{{index}}"
          class="picker-cell {{idx[1] === index ? 'active' : ''}} {{item === '其他' ? 'cell-other' : ''}}"
          wx:for="{{floors}}"
          wx:key="*this"
          data-col="1"
          data-i="{{index}}"
          bindtap="pick"
        >{{item}}</view>
      </scroll-view>
      <scroll-view
        class="picker-col"
        scroll-y="{{true}}"
        show-scrollbar="{{true}}"
        enhanced="{{false}}"
        scroll-into-view="c2-{{idx[2]}}"
        style="height:{{colHeight}}rpx"
      >
        <view
          id="c2-{{index}}"
          class="picker-cell {{idx[2] === index ? 'active' : ''}} {{item === '其他' ? 'cell-other' : ''}}"
          wx:for="{{rooms}}"
          wx:key="*this"
          data-col="2"
          data-i="{{index}}"
          bindtap="pick"
        >{{item}}</view>
      </scroll-view>
    </view>

    <view class="picker-custom" wx:if="{{other0 || other1 || other2}}">
      <input
        wx:if="{{other0}}"
        class="custom-input"
        placeholder="请输入楼栋 / 地点，例如：校门口快递站"
        value="{{custom[0]}}"
        data-col="0"
        bindinput="onCustomInput"
        maxlength="30"
      />
      <input
        wx:if="{{other1}}"
        class="custom-input"
        placeholder="请输入楼层，例如：负一层 / 架空层"
        value="{{custom[1]}}"
        data-col="1"
        bindinput="onCustomInput"
        maxlength="20"
      />
      <input
        wx:if="{{other2}}"
        class="custom-input"
        placeholder="请输入宿舍号 / 位置，例如：宿管处"
        value="{{custom[2]}}"
        data-col="2"
        bindinput="onCustomInput"
        maxlength="20"
      />
      <view class="custom-tip">选了「其他」就要把内容写清楚，方便接单同学找得到</view>
    </view>
  </view>
</view>
