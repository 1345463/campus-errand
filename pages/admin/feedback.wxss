/* 意见反馈处理 */

/* 反馈正文：保留用户换行，整块灰底便于扫读 */
.fb-content {
  margin: 16rpx 0;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--fill);
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 驳回理由输入框 */
.note-box {
  margin-top: 16rpx;
}

.note-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--fill);
  font-size: 28rpx;
  color: var(--t1);
}

/* 已处理的反馈整条压暗，让待处理的更显眼 */
.apply-card .status-text.status-resolved {
  color: var(--success);
}

.apply-card .status-text.status-rejected {
  color: var(--danger);
}

.apply-card .status-text.status-pending {
  color: var(--warn);
}

/* 会话摘要：最近一条回复的预览 */
.chat-preview {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--fill);
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.6;
  word-break: break-all;
}
