/* 灰度开关总闸 */

/* 每条开关的说明区，和卡片标题拉开距离 */
.settle-rule {
  margin-top: 8rpx;
}

/* 开关按钮：关闭态灰底，开启态主题色 */
.chip.chip-shortcut {
  min-width: 140rpx;
  text-align: center;
}

.chip.chip-shortcut.active {
  background: var(--brand);
  border-color: var(--brand);
  color: #FFFFFF;
}

/* 二次确认时出现的行动区说明 */
.settle-feedback {
  font-size: 26rpx;
  color: var(--t2);
  background: #FFF6F7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.tool-row {
  margin-bottom: 20rpx;
}
