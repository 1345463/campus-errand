<view class="page">
  <view wx:if="{{needLogin}}" class="empty">
    <view>登录后才能使用管理后台</view>
    <view class="btn-primary top-gap" bindtap="goLogin">去登录</view>
  </view>

  <view wx:elif="{{denied}}" class="empty">
    <view>没有管理权限</view>
    <view class="hint top-gap">请到「我的」页用管理员口令开通</view>
  </view>

  <view wx:else>
    <view class="filter-row">
      <view
        class="chip {{tab === item.key ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="switchTab"
      >{{item.label}}</view>
    </view>

    <view class="err-bar" wx:if="{{errorText}}">
      <text class="err-text">{{errorText}}</text>
      <text class="err-retry" bindtap="retry">重试</text>
    </view>
    <view class="tip-bar" wx:if="{{tipText && !errorText}}">
      <text class="tip-text">{{tipText}}</text>
    </view>

    <view class="tool-row">
      <view class="doc-btn" bindtap="retry">刷新列表</view>
      <view class="doc-btn {{actingId === -1 ? 'disabled' : ''}}" bindtap="makeDemo">
        {{actingId === -1 ? '生成中…' : '生成测试申请'}}
      </view>
    </view>

    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{list.length === 0 && !errorText}}" class="empty">
      <view>没有符合条件的申请</view>
      <view class="hint top-gap">还没有同学提交认证，可以用上方的「生成测试申请」先走通流程</view>
    </view>

    <view wx:else>
      <view class="card apply-card" wx:for="{{list}}" wx:key="id">
        <view class="apply-head">
          <text class="apply-name">{{item.nickname}}</text>
          <text class="status-text status-{{item.status}}">{{item.statusText}}</text>
        </view>

        <view class="detail-row">
          <view class="detail-label">真实姓名</view>
          <view class="detail-value">{{item.realName || '未填写'}}</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">身份证号</view>
          <view class="detail-value">{{item.idNoMasked}}</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">提交时间</view>
          <view class="detail-value">{{item.createdText}}</view>
        </view>
        <view class="detail-row last">
          <view class="detail-label">用户 ID</view>
          <view class="detail-value">{{item.ownerId}}</view>
        </view>

        <view class="doc-row">
          <view class="doc-btn" data-id="{{item.id}}" data-kind="student" bindtap="viewDoc">
            查看学生证
          </view>
          <view class="doc-btn" data-id="{{item.id}}" data-kind="id" bindtap="viewDoc">
            查看身份证
          </view>
        </view>

        <block wx:if="{{item.status === 'pending'}}">
          <view wx:if="{{noteId === item.id}}" class="note-box">
            <textarea
              class="note-input"
        placeholder-class="field-ph"
              placeholder="驳回原因（会展示给该同学）"
              value="{{note}}"
              bindinput="onNoteInput"
              maxlength="100"
              auto-height="{{true}}"
            />
            <view class="btn-row">
              <view class="btn-ghost half" bindtap="cancelNote">取消</view>
              <view
                class="btn-danger half {{actingId === item.id ? 'disabled' : ''}}"
                data-id="{{item.id}}"
                bindtap="reject"
              >确认驳回</view>
            </view>
          </view>
          <view wx:else class="btn-row">
            <view
              class="btn-ghost half"
              wx:if="{{actingId !== item.id}}"
              data-id="{{item.id}}"
              bindtap="openNote"
            >驳回</view>
            <view
              class="btn-primary half {{actingId === item.id ? 'disabled' : ''}} {{armId === item.id ? 'btn-armed' : ''}}"
              data-id="{{item.id}}"
              bindtap="approve"
            >{{armId === item.id ? '再点一次确认通过' : (actingId === item.id ? '处理中…' : '通过认证')}}</view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view wx:if="{{previewUrl}}" class="img-mask" bindtap="closePreview">
    <image class="img-preview" src="{{previewUrl}}" mode="widthFix" />
    <view class="img-tip">点任意处关闭</view>
  </view>
</view>
