<view class="page">
  <view wx:if="{{needLogin}}" class="empty">
    <view>登录后才能使用管理后台</view>
    <view class="btn-primary top-gap" bindtap="goLogin">去登录</view>
  </view>

  <view wx:elif="{{denied}}" class="empty">
    <view>没有管理权限</view>
    <view class="hint top-gap">请到「我的」页用管理员口令开通</view>
  </view>

  <view wx:else>
    <view class="err-bar" wx:if="{{errorText}}">
      <text class="err-text">{{errorText}}</text>
      <text class="err-retry" bindtap="load">重试</text>
    </view>

    <view class="tool-row">
      <view class="doc-btn" bindtap="load">刷新列表</view>
    </view>

    <view class="card pay-card" wx:if="{{pay}}">
      <view class="pay-title">结算与抽佣</view>
      <view class="pay-hint">改完立即生效，只影响之后确认完成的订单；已结算的订单不受影响</view>

      <view class="pay-row">
        <view class="pay-label">平台抽佣</view>
        <input class="pay-input" type="digit" value="{{rateText}}" bindinput="onRateInput" placeholder="0" />
        <view class="pay-unit">%</view>
      </view>
      <view class="pay-row">
        <view class="pay-label">提现门槛</view>
        <input class="pay-input" type="digit" value="{{minWithdrawText}}" bindinput="onMinWithdrawInput" placeholder="10.00" />
        <view class="pay-unit">元</view>
      </view>
      <view class="pay-row">
        <view class="pay-label">提现手续费</view>
        <input class="pay-input" type="digit" value="{{feeText}}" bindinput="onFeeInput" placeholder="0" />
        <view class="pay-unit">%</view>
      </view>

      <view class="pay-switch-row">
        <view class="pay-label">在线支付总闸</view>
        <switch checked="{{payEnabled}}" color="#2E7CF6" bindchange="onTogglePay" />
      </view>
      <view class="pay-hint">关闭后新订单不走微信支付，直接视为已付款（线下收款模式）</view>

      <view class="doc-btn pay-save" bindtap="savePay">{{savingPay ? '保存中…' : '保存设置'}}</view>
    </view>

    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:elif="{{list.length === 0 && !errorText}}" class="empty">
      <view>没有待核查的结算申请</view>
      <view class="hint top-gap">接单员提交完成满 48 小时、发布方仍未确认时，才能在这里看到申请</view>
    </view>

    <view class="card apply-card" wx:for="{{list}}" wx:key="id">
      <view class="apply-head">
        <text class="apply-name">{{item.title}}</text>
        <text class="status-text status-accepted">待核查</text>
      </view>

      <view class="detail-row">
        <view class="detail-label">赏金</view>
        <view class="detail-value">¥{{item.reward}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">发布方</view>
        <view class="detail-value">{{item.ownerName || '未填写'}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">接单员</view>
        <view class="detail-value">{{item.runnerName || '未填写'}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">送达时间</view>
        <view class="detail-value">{{item.doneAtText}}</view>
      </view>
      <view class="detail-row">
        <view class="detail-label">申请时间</view>
        <view class="detail-value">{{item.feedbackAtText}}</view>
      </view>
      <view class="detail-row last">
        <view class="detail-label">接单员说明</view>
        <view class="detail-value">{{item.feedbackText || '未填写'}}</view>
      </view>

      <view wx:if="{{noteId === item.id}}" class="note-box">
        <textarea
          class="note-input"
        placeholder-class="field-ph"
          placeholder="驳回原因（会展示给接单员）"
          value="{{note}}"
          bindinput="onNoteInput"
          maxlength="100"
          auto-height="{{true}}"
        />
        <view class="btn-row">
          <view class="btn-ghost half" bindtap="cancelNote">取消</view>
          <view class="btn-danger half {{actingId === item.id ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="reject">
            确认驳回
          </view>
        </view>
      </view>
      <view wx:else class="btn-row">
        <view
          class="btn-ghost half"
          wx:if="{{actingId !== item.id}}"
          data-id="{{item.id}}"
          bindtap="openNote"
        >驳回</view>
        <view
          class="btn-primary half {{actingId === item.id ? 'disabled' : ''}} {{armId === item.id ? 'btn-armed' : ''}}"
          data-id="{{item.id}}"
          bindtap="approve"
        >{{armId === item.id ? '再点一次确认打款' : (actingId === item.id ? '处理中…' : '判定通过并结算')}}</view>
      </view>
    </view>
  </view>
</view>
