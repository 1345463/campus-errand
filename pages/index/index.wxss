/* 首页轮播 */

.banner-box {
  margin: 20rpx 20rpx 24rpx;
}

/* 比例必须和后台上传的图严格一致，否则 aspectFill 会把图片上下裁掉（文字会被切）。
   容器宽度 = 750 - 左右各 20 边距 = 710rpx，高度 = 710 / 2.5 = 284rpx。
   → 上传尺寸按 1500×600（2 倍图，2.5:1）。改宽度就要同步改高度。 */
.banner-swiper {
  width: 100%;
  height: 284rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--sd-2);
}

.banner-img {
  width: 100%;
  height: 284rpx;
  display: block;
}

/* 大厅筛选区：两行 chip，行间留一点间距 */
.filter-row {
  margin-bottom: 16rpx;
}

.filter-row + .filter-row {
  margin-top: -4rpx;
}

/* 大厅门槛卡片：未成为接单员时用它顶掉任务列表 */
.lock-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.lock-icon {
  font-size: 64rpx;
  line-height: 1;
}

.lock-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}

.lock-desc {
  margin-top: 12rpx;
  text-align: left;
}

/* 任务大厅入口卡：列表已经搬到大厅页，首页只留这一个入口。
   做成品牌渐变的「主入口」，让首页有一个明确的视觉落点。 */
.hall-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--brand-50) 0%, #FFFFFF 100%);
  border: 1rpx solid var(--brand-100);
  box-shadow: var(--sd-1);
  padding: 32rpx 28rpx;
}

.hall-entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand-600);
}

.hall-entry-main {
  flex: 1;
  min-width: 0;
}

.hall-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}

.hall-entry-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--t3);
}
