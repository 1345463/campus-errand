<view class="page">
  <view class="card">
    <view class="section-head">
      <text class="section-title">{{bound ? '已绑定手机号' : '绑定手机号'}}</text>
    </view>

    <view wx:if="{{bound}}" class="bp-state">
      <text class="bp-phone">{{boundPhone}}</text>
      <text class="hint">一个手机号只能绑定一个账号。更换号码后 24 小时内不能再改。</text>
    </view>
    <view wx:else class="bp-intro">
      <text class="hint">发单、接单和查看对方联系方式前需要绑定手机号，用于对方联系你。浏览任务大厅不需要绑定。</text>
    </view>

    <view class="field">
      <view class="field-label">手机号</view>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        placeholder="请输入 11 位手机号"
        value="{{phone}}"
        bindinput="onPhone"
      />
    </view>

    <view class="field">
      <view class="field-label">验证码</view>
      <view class="bp-code-row">
        <input
          class="field-input bp-code-input"
          type="number"
          maxlength="6"
          placeholder="短信验证码"
          value="{{code}}"
          bindinput="onCode"
        />
        <view
          class="code-btn pressable {{countdown > 0 || sending ? 'disabled' : ''}}"
          bindtap="sendCode"
        >{{countdown > 0 ? countdown + ' 秒后重发' : (sending ? '发送中…' : '获取验证码')}}</view>
      </view>
    </view>

    <view wx:if="{{formError}}" class="bp-error">{{formError}}</view>
    <view wx:if="{{devHint}}" class="bp-dev-hint">{{devHint}}</view>

    <view class="btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submit">{{submitting ? '绑定中…' : (bound ? '更换手机号' : '确认绑定')}}</view>

    <view class="hint bp-foot">手机号只用于订单联系与账号找回。未绑定手机号的用户看不到你的号码。</view>
  </view>
</view>
