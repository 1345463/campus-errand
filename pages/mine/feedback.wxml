<view class="page">
  <view wx:if="{{grayOff}}" class="empty">
    <view>意见反馈暂未开放</view>
    <view class="hint top-gap">功能还在内测，开放后这里会出现入口</view>
  </view>

  <view wx:elif="{{needLogin}}" class="empty">
    <view>登录后才能提交反馈</view>
    <view class="btn-primary top-gap" bindtap="goLogin">去「我的」登录</view>
  </view>

  <view wx:else>
    <view class="card">
      <view class="section-head">
        <text class="section-title">反馈类型</text>
      </view>
      <view class="chip-row">
        <view
          class="chip chip-shortcut {{kind === item.key ? 'active' : ''}}"
          wx:for="{{kinds}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="pickKind"
        >{{item.label}}</view>
      </view>
      <view class="hint">{{kindDesc}}</view>
    </view>

    <view class="card">
      <view class="section-head">
        <text class="section-title">具体内容</text>
        <text class="section-more">{{countText}}</text>
      </view>
      <textarea
        class="field-textarea"
        placeholder-class="field-ph"
        placeholder="说说你遇到的问题或想法，最好带上订单号，方便我们定位"
        value="{{content}}"
        maxlength="500"
        bindinput="onContentInput"
      ></textarea>
    </view>

    <view class="card">
      <view class="section-head">
        <text class="section-title">联系方式（选填）</text>
      </view>
      <input
        class="field-input"
        placeholder-class="field-ph"
        placeholder="手机号或微信号，方便我们回复你"
        value="{{contact}}"
        maxlength="60"
        bindinput="onContactInput"
      ></input>
    </view>

    <view class="card">
      <view class="btn-primary" bindtap="submit">提交反馈</view>
      <view class="hint top-gap-sm">客服处理后你会收到一条站内消息，处理结果也会显示在下面</view>
    </view>

    <view class="card">
      <view class="section-head">
        <text class="section-title">我提交过的</text>
      </view>
      <view wx:if="{{!mineLoaded}}" class="hint">加载中…</view>
      <view wx:elif="{{mine.length === 0}}" class="hint">还没有提交过反馈</view>
      <view wx:else>
        <!--
          这里不能用全局的 .detail-row / .detail-label：那条规则把左侧写死成 180rpx，
          而这一行要放的是「类型·时间 + 正文 + 最新回复」，180rpx 会把
          「最新（10-30 00:28）」在时间中间折断（截图里就是 00:2 8）。
          换成本页专属的 fb-row，左侧可收缩、右侧状态块不参与压缩。
        -->
        <view class="fb-row" wx:for="{{mine}}" wx:for-item="row" wx:key="id" data-id="{{row.id}}" bindtap="openThread">
          <view class="fb-main">
            <text class="flow-kind">{{row.kindText}} · {{row.timeText}}</text>
            <text class="flow-time">{{row.content}}</text>
            <text wx:if="{{row.note}}" class="flow-time">客服处理：{{row.note}}</text>
            <text wx:if="{{row.lastPreview}}" class="flow-time">最新（{{row.lastTimeText}}）{{row.lastRoleText}}：{{row.lastPreview}}</text>
            <text wx:if="{{row.replyCount > 0}}" class="flow-link">💬 共 {{row.replyCount}} 条对话，点这里继续沟通</text>
            <text wx:elif="{{row.statusText === '已受理'}}" class="flow-link">💬 客服已受理，点这里可以追问</text>
            <text wx:if="{{row.unreadCount > 0}}" class="flow-unread">{{row.unreadCount}} 条未读</text>
          </view>
          <view class="fb-side">
            <text class="status-block {{row.statusClass}}">{{row.statusText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
