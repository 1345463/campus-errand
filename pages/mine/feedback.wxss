/* 意见反馈 */

/* 历史列表一行：左侧占满剩余宽度、右侧状态块固定不压缩。
   用专属类而不是 .detail-label（全局把左侧写死 180rpx，长文本会在数字中间折断）。 */
.fb-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--fill);
}

.fb-main {
  flex: 1;
  min-width: 0;
}

.fb-side {
  flex: none;
  margin-left: 16rpx;
  padding-top: 4rpx;
}

.flow-kind {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
}

.flow-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.5;
  word-break: break-all;
}

/* 处理状态色块 */
.status-block {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #FFFFFF;
}

.status-block.status-pending {
  background: var(--warn);
}

.status-block.status-approved {
  background: var(--success);
}

.status-block.status-rejected {
  background: var(--danger);
}

/* 会话入口：客服受理后可以在里面继续追问 */
.flow-link {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--success);
}

.flow-unread {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--danger);
}
