/* 意见反馈 */

.flow-kind {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
}

.flow-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.5;
  word-break: break-all;
}

/* 处理状态色块 */
.status-block {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #FFFFFF;
}

.status-block.status-pending {
  background: var(--warn);
}

.status-block.status-approved {
  background: var(--success);
}

.status-block.status-rejected {
  background: var(--danger);
}

/* 会话入口：客服受理后可以在里面继续追问 */
.flow-link {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--success);
}

.flow-unread {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--danger);
}
