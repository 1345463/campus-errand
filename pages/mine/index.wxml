<view class="page mine {{motionClass}}">
  <!-- 自定义导航：透明底，直接压在下面的渐变头部上 -->
  <nav-bar bg="transparent" title="" />

  <!-- ===== 未登录 =====
       只保留微信一键登录。原来这里还有一套「手机号 + 密码」的登录/注册表单：
       它会造出一个和微信身份并存的手机号账号（R44 之后已经不用密码登录了），
       一旦这个号码后来又被拿去「绑定手机号」，verifyOtp 会直接登录进那个老账号，
       用户看到的就是「绑完跳到另一个账号」。整套删掉，账号体系只留微信身份一种。 -->
  <view wx:if="{{!logged}}" class="login-wrap" style="padding-top:{{navTotal}}px">
    <view class="login-brand anim anim-pop">
      <view class="login-brand-mark">跑</view>
      <view class="login-title">校园跑腿</view>
    </view>
    <view class="login-desc">{{school}} · 同学互助跑腿平台</view>

    <view class="agree-row login-agree pressable" hover-class="press" bindtap="toggleAgreed">
      <view class="agree-box {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="agree-tick">✓</text>
      </view>
      <text class="agree-text">
        {{agreementNotice}}（<text class="link" catchtap="goAgreement">查看全文</text>）
      </text>
    </view>
    <view
      class="btn-primary btn-shine top-gap pressable {{logining ? 'btn-disabled' : ''}}"
      hover-class="press"
      hover-stay-time="120"
      bindtap="onLogin"
    >{{logining ? '登录中…' : '微信一键登录'}}</view>
    <view class="hint">微信登录需要在真机或体验版里使用；开发者工具请用「真机调试」或预览。</view>
  </view>

  <!-- ===== 已登录 ===== -->
  <view wx:else>
    <!-- 渐变头部：底部用一段弧形过渡到页面底色，比硬切一条直线柔和 -->
    <view class="mine-hero" style="padding-top:{{navTotal}}px">
      <view class="hero-bg hero-flow"></view>
      <view class="hero-orb hero-orb-a"></view>
      <view class="hero-orb hero-orb-b"></view>

      <view class="mine-hero-inner">
        <!-- 点头像 / 用户名区域即可修改头像与用户名 -->
        <view class="profile-main pressable" hover-class="press" hover-stay-time="120" bindtap="goProfile">
          <view class="avatar avatar-tap">
            <image wx:if="{{avatarSrc}}" class="avatar-img" src="{{avatarSrc}}" mode="aspectFill"></image>
            <text wx:else>{{initial}}</text>
            <view class="avatar-edit">改</view>
          </view>
          <view class="profile-info">
            <view class="uname">{{nicknameText}}</view>
            <view class="uid">ID {{uidText}}</view>
            <view class="uid">点击这里修改头像和用户名</view>
          </view>
        </view>
        <view class="role-switch {{switching ? 'disabled' : ''}}" bindtap="toggleRole">
          <view class="role-opt {{roleText === '用户' ? 'on' : ''}}">用户</view>
          <view class="role-opt {{roleText === '接单员' ? 'on' : ''}}">接单员</view>
        </view>
      </view>

      <view class="mine-hero-wave"></view>
    </view>

    <!-- 统计栏：数字滚动进场 -->
    <view class="stat-row anim anim-up">
      <view class="stat-item pressable" hover-class="press" bindtap="goPoints">
        <view class="stat-num">{{points}}</view>
        <view class="stat-label">积分 <text class="stat-arrow">></text></view>
      </view>
      <view class="stat-item pressable" hover-class="press" bindtap="goWallet">
        <view class="stat-num">{{balance}}</view>
        <view class="stat-label">钱包（元）<text class="stat-arrow">></text></view>
      </view>
      <view wx:if="{{flagsOn.credit_score}}" class="stat-item pressable" hover-class="press" bindtap="goCredit">
        <view class="stat-num">{{creditScore}}</view>
        <view class="stat-label">信誉分 <text class="stat-arrow">></text></view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{certShort}}</view>
        <view class="stat-label">接单资格</view>
      </view>
    </view>

    <view class="card anim anim-up" style="--d:60ms">
      <view class="section-head">
        <text class="section-title">我的订单</text>
      </view>
      <!-- 状态入口必须挤在一行：这里用 .order-chips 关掉换行并等分宽度，
           不再用带右边距的默认 chip 排布（默认排布会挤到第二行）。
           「待评价」是评价页的唯一入口，所以菜单里不再重复列一项「我的评价」。 -->
      <view class="filter-row order-chips">
        <view
          class="chip pressable {{orderFilter === 'all' ? 'active' : ''}}"
          data-status="all"
          hover-class="press"
          bindtap="goOrders"
        >全部</view>
        <view
          class="chip pressable {{orderFilter === 'pending' ? 'active' : ''}}"
          data-status="pending"
          hover-class="press"
          bindtap="goOrders"
        >待接单</view>
        <view
          class="chip pressable {{orderFilter === 'accepted' ? 'active' : ''}}"
          data-status="accepted"
          hover-class="press"
          bindtap="goOrders"
        >进行中</view>
        <view
          class="chip pressable {{orderFilter === 'done' ? 'active' : ''}}"
          data-status="done"
          hover-class="press"
          bindtap="goOrders"
        >已完成</view>
        <view wx:if="{{flagsOn.my_reviews}}" class="chip pressable" hover-class="press" bindtap="goMyReviews">
          待评价
        </view>
      </view>
    </view>

    <view class="menu-list anim anim-up" style="--d:100ms">
      <view class="menu-item pressable" hover-class="press" hover-stay-time="100" bindtap="goApply">
        <text class="menu-icon">🪪</text>
        <text class="menu-label">成为接单员</text>
        <text class="menu-value">{{certText}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item pressable" hover-class="press" hover-stay-time="100" bindtap="goAccepted">
        <text class="menu-icon">🧾</text>
        <text class="menu-label">我接的单</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item pressable" hover-class="press" hover-stay-time="100" bindtap="goRental">
        <text class="menu-icon">📷</text>
        <text class="menu-label">相机租赁</text>
        <text class="menu-arrow">></text>
      </view>


      <!-- 评价、信誉分、头像用户名都不在这里重复列：
           它们各自的入口已经长在上面（我的订单的「待评价」chip、
           统计栏的「信誉分」格子、头像区），同一个目标页只留一个入口。 -->

      <!-- 消息中心：灰度开才出现，右上角带未读数 -->
      <view
        wx:if="{{flagsOn.message_center}}"
        class="menu-item pressable"
        hover-class="press"
        hover-stay-time="100"
        bindtap="goMessages"
      >
        <text class="menu-icon">🔔</text>
        <text class="menu-label">消息中心</text>
        <text wx:if="{{unread > 0}}" class="menu-value">未读 {{unread}}</text>
        <text wx:else class="menu-value">暂无新消息</text>
        <text class="menu-arrow">></text>
      </view>
      <view
        wx:if="{{flagsOn.point_mall}}"
        class="menu-item pressable"
        hover-class="press"
        hover-stay-time="100"
        bindtap="goMall"
      >
        <text class="menu-icon">🎁</text>
        <text class="menu-label">积分商城</text>
        <text class="menu-value">{{points}} 分</text>
        <text class="menu-arrow">></text>
      </view>
      <view
        wx:if="{{flagsOn.user_feedback}}"
        class="menu-item pressable"
        hover-class="press"
        hover-stay-time="100"
        bindtap="goFeedback"
      >
        <text class="menu-icon">💬</text>
        <text class="menu-label">意见反馈</text>
        <text class="menu-arrow">></text>
      </view>

      <!-- 后台入口始终可达，具体权限由服务端验证。 -->
      <view
        class="menu-item pressable"
        hover-class="press"
        hover-stay-time="100"
        bindtap="goAdminEntry"
      >
        <text class="menu-icon">🗂️</text>
        <text class="menu-label">{{isAnyAdmin || isAdmin ? '管理员工作台' : '后台密码入口'}}</text>
        <text class="menu-value">{{isAnyAdmin || isAdmin ? '全部后台功能' : '输入后台密码'}}</text>
        <text class="menu-arrow">></text>
      </view>

      <!-- 智能客服：FAQ 固定回答 + AI 兜底，灰度开才出现 -->
      <view
        wx:if="{{flagsOn.ai_support}}"
        class="menu-item pressable"
        hover-class="press"
        hover-stay-time="100"
        bindtap="goSupport"
      >
        <text class="menu-icon">🤖</text>
        <text class="menu-label">智能客服</text>
        <text class="menu-value">常见问题 · 在线答疑</text>
        <text class="menu-arrow">></text>
      </view>

      <!-- 低频设置收进二级页：我的地址、动效与触感、管理员权限、用户协议、关于 -->
      <view class="menu-item pressable" hover-class="press" hover-stay-time="100" bindtap="goSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-label">设置</text>
        <text class="menu-value">地址 · 动效 · 权限 · 协议</text>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item last pressable" hover-class="press" hover-stay-time="100" bindtap="onLogout">
        <text class="menu-icon">🚪</text>
        <text class="menu-label">{{logoutArmed ? '再点一次确认退出' : '退出登录'}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>
