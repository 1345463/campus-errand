/* 积分商城 */

/* 两列商品卡。
   用 space-between 自动分配列间距，不要写 :nth-child(2n) 去摘右外边距 ——
   WXSS 对伪类支持不稳，能不用就不用。 */
.mall-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.mall-item {
  width: 48%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--fill);
}

.mall-item.disabled {
  opacity: 0.55;
}

.mall-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.mall-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}

.mall-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.5;
  min-height: 72rpx;
}

.mall-cost {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
}

.mall-stock {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--t3);
}

.mall-btn {
  margin-top: 16rpx;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 26rpx;
  text-align: center;
}

/* 进入待确认状态后变深色，提示"再点一次" */
.mall-btn.btn-armed {
  background: #E03E5F;
}

.mall-btn.disabled {
  background: var(--line);
  color: var(--t3);
}

/* 兑换码卡片 */
.code-card {
  margin-bottom: 0;
}

.code-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
}

.code-value {
  margin-top: 16rpx;
  padding: 20rpx 0;
  border-radius: 14rpx;
  background: var(--brand-100);
  color: var(--brand);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: center;
}

.code-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--t3);
}

.code-copy {
  margin-top: 16rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 26rpx;
  text-align: center;
}

/* 兑换记录里的兑换码 / 时间，和意见反馈页保持同一套样式 */
.flow-kind {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
}

.flow-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.5;
  word-break: break-all;
}

/* 我的兑换码：每行一张券，右侧操作区竖排，窄屏也不挤 */
.coupon-list {
  margin-top: 8rpx;
}

.coupon-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--fill);
}

.coupon-row:last-child {
  border-bottom: none;
}

.coupon-row.used .coupon-code,
.coupon-row.used .coupon-title {
  color: var(--t3);
}

.coupon-main {
  flex: 1;
  min-width: 0;
}

.coupon-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--t1);
}

.coupon-title .status-text {
  margin-left: 12rpx;
}

.coupon-code {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--brand-600);
  word-break: break-all;
}

.coupon-hint {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.5;
}

.coupon-ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.coupon-op {
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--t2);
}

.coupon-op.primary {
  margin-top: 12rpx;
  border-color: var(--brand-600);
  color: var(--brand-600);
}
