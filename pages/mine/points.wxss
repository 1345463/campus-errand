/* 我的积分：流水明细 */

.flow-kind {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
}

.flow-time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--t3);
}

/* 积分增减：按校园产品习惯，增加用醒目色，扣减用中性灰 */
.flow-plus {
  color: var(--brand);
  font-weight: 600;
}

.flow-minus {
  color: var(--t2);
  font-weight: 600;
}
