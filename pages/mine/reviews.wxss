/* 我的评价 */

.flow-kind {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
}

.flow-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.5;
  word-break: break-all;
}

.score-star {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

.mini-btn {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 24rpx;
}
