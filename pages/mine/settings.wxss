/* 设置页：把「我的」页里那些低频入口收进来，分组成 常用 / 体验 / 账号与权限 / 关于 */

.settings {
  padding: 0 20rpx 40rpx;
}

/* 卡片之间留呼吸位：这里每张卡是一个分组 */
.settings .card {
  margin-top: 20rpx;
}

/* 菜单项主体：主标题 + 副说明两行。
   副说明不能挤掉主标题的位置，所以给外层一个可收缩的列 */
.menu-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.menu-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--t3);
  line-height: 1.5;
}

/* 「复制」这类行内提示，比 menu-value 更弱，且不该抢走箭头的视觉重量 */
.menu-hint {
  font-size: 24rpx;
  color: var(--brand);
  margin-left: 12rpx;
}

/* 管理员口令面板：从「我的」页搬过来，样式保持一致 */
.admin-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: var(--r);
  background: var(--fill);
}

.admin-error {
  margin-top: 16rpx;
  color: var(--warn);
  font-size: 24rpx;
}

/* ===== 关于 ===== */

.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx 12rpx;
  text-align: center;
}

.about-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #2E7CF6 0%, #4FA1FF 100%);
  color: #FFFFFF;
  font-size: 46rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sd-brand);
}

.about-name {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--t1);
}

.about-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--t3);
}

.about-notice {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--t3);
}

/* 注销账号：这一行是破坏性操作，文字用 danger 色，别和普通入口一个观感 */
.menu-danger {
  color: var(--danger);
}

/* ===== 销号确认弹窗：底部抽屉式，必须勾选才可提交 ===== */
.del-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.55);
}

.del-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 28rpx 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--card);
}

.del-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 20rpx;
}

.del-body {
  padding: 20rpx;
  border-radius: var(--r);
  background: var(--fill);
}

.del-line {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--t2);
  margin-bottom: 8rpx;
}

.del-strong {
  font-weight: 600;
  color: var(--danger);
}

.del-field {
  margin-top: 20rpx;
}

.del-agree {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 24rpx;
}

.del-box {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  margin-top: 4rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--line);
  background: var(--card);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
}

.del-box.on {
  border-color: var(--danger);
  background: var(--danger);
}

.del-agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--t2);
}

.del-error {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--danger);
}

.del-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.del-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
}

.del-btn.ghost {
  color: var(--t2);
  background: var(--fill);
}

.del-btn.danger {
  color: #ffffff;
  background: var(--danger);
}

.del-btn.disabled {
  opacity: 0.5;
}
