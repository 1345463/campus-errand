<view class="page support-page {{motionClass}}" style="padding-top:{{navTotal}}px">
  <nav-bar title="智能客服" showBack="{{true}}" />

  <!-- 灰度未开：功能还没上线完，先不让它出现 -->
  <view wx:if="{{grayOff}}" class="empty">
    <view>智能客服正在灰度中</view>
    <view class="hint top-gap">功能还在内测，开放后会出现在「我的」页</view>
    <view class="btn-ghost top-gap" bindtap="goBack">返回</view>
  </view>

  <view wx:elif="{{loading}}" class="empty">加载中…</view>

  <view wx:elif="{{errorText}}" class="empty">
    <view>{{errorText}}</view>
    <view class="btn-ghost top-gap" bindtap="reload">重试</view>
    <view class="btn-primary top-gap" bindtap="goBack">返回</view>
  </view>

  <view wx:else>
    <view class="sup-tools">
      <text bindtap="clearChat">清空对话</text>
      <text wx:if="{{ticketId}}" bindtap="openTicket">查看工单 #{{ticketId}}</text>
    </view>
    <!-- 热门问题：第一次进来最容易发生的就是"不知道该问什么" -->
    <view wx:if="{{hot.length > 0}}" class="sup-hot">
      <view class="sup-hot-head" bindtap="toggleHot">
        <text class="sup-hot-title">大家都在问</text>
        <text class="sup-hot-toggle">{{hotOpen ? '收起' : '展开'}}</text>
      </view>
      <scroll-view wx:if="{{hotOpen}}" class="sup-hot-scroll" scroll-x="{{true}}">
        <view class="sup-hot-row">
          <view
            class="sup-hot-chip"
            wx:for="{{hot}}"
            wx:for-item="item"
            wx:key="id"
            data-q="{{item.question}}"
            hover-class="press"
            hover-stay-time="90"
            bindtap="onHotTap"
          >{{item.question}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 会话内容：普通文档流，整页滚动。
         不用 scroll-view —— 它的内容高度在各基础库上算不准，坑了五轮。
         padding-bottom 由 JS 按输入区实测高度给，保证最后一条不被输入区盖住。 -->
    <view class="sup-chat" style="padding-bottom:{{chatPad}}px">
      <view
        wx:for="{{messages}}"
        wx:for-item="msg"
        wx:key="id"
        class="msg-row {{msg.role === 'me' ? 'msg-mine' : 'msg-peer'}}"
      >
        <view class="msg-bubble {{msg.pending ? 'pending' : ''}}">{{msg.text}}</view>
        <!-- 发送方与时间挤在同一行的小字里，少一行 = 少一道视觉分隔 -->
        <view class="msg-tag {{msg.failed ? 'warn' : ''}}">
          <text wx:if="{{msg.role === 'me'}}">我 · {{msg.timeText}}</text>
          <text wx:elif="{{msg.kind === 'faq'}}">常见问题 · {{msg.timeText}}</text>
          <text wx:elif="{{msg.kind === 'tip'}}">助手 · {{msg.timeText}}</text>
          <text wx:else>AI 助手 · {{msg.timeText}}</text>
        </view>
        <view wx:if="{{msg.role === 'bot' && !msg.pending && (msg.kind === 'faq' || msg.question)}}" class="sup-actions">
          <text wx:if="{{!msg.failed && !msg.rating}}" data-id="{{msg.id}}" data-rating="helpful" bindtap="rateAnswer">有帮助</text>
          <text wx:if="{{!msg.failed && !msg.rating}}" data-id="{{msg.id}}" data-rating="unhelpful" bindtap="rateAnswer">没帮助</text>
          <text wx:if="{{msg.rating}}">已反馈</text>
          <text wx:if="{{msg.question}}" data-id="{{msg.id}}" bindtap="regenerate">重新生成</text>
        </view>
      </view>
    </view>

    <!-- 输入区：固定在屏幕底部，消息从它上方滚过 -->
    <view class="sup-input" style="bottom:{{keyboardHeight}}px">
      <view wx:if="{{aiReady && !signedIn}}" class="sup-quota" bindtap="goLogin">登录后可使用 AI 回答，点此登录</view>
      <view wx:elif="{{aiReady}}" class="sup-quota">今日 AI 提问剩余 {{aiLeftText}} / {{aiLimit}} 次</view>
      <view wx:else class="sup-quota dim">可咨询常见问题，也可以转人工</view>
      <view class="sup-input-row">
        <textarea
          class="sup-textarea"
          placeholder-class="field-ph"
          placeholder="描述你的问题，尽量具体一点"
          value="{{input}}"
          bindinput="onInput"
          bindfocus="onFocus"
          maxlength="{{inputLimit}}"
          fixed="{{true}}"
          hold-keyboard="{{true}}"
          adjust-position="{{false}}"
          bindkeyboardheightchange="onKeyboardHeightChange"
          bindlinechange="measureInput"
          show-confirm-bar="{{false}}"
          auto-height="{{true}}"
        />
      </view>
      <view wx:if="{{inputWarning}}" class="sup-warning">{{inputWarning}}</view>
      <view class="sup-send-row">
        <view class="sup-human" hover-class="press" hover-stay-time="90" bindtap="openHuman">转人工</view>
        <text class="sup-count">{{countText}}</text>
        <view class="sup-send {{sending ? 'disabled' : ''}}" bindtap="send">{{sending ? '回答中…' : '发送'}}</view>
      </view>
    </view>
  </view>

  <!-- 转人工面板：盖在输入区上方，填个联系方式就能提交工单 -->
  <view wx:if="{{humanOpen}}" class="sup-mask" bindtap="closeHuman">
    <view class="sup-panel" catchtap="noop">
      <view class="sup-panel-title">转人工客服</view>
      <view class="sup-panel-desc">会把最近的对话一起提交给客服，方便对方直接看懂你的问题。</view>
      <input
        class="field-input"
        placeholder="联系方式（手机号/微信，选填）"
        value="{{humanContact}}"
        bindinput="onContactInput"
      />
      <view class="sup-panel-row">
        <view class="sup-panel-cancel" bindtap="closeHuman">取消</view>
        <view class="sup-panel-ok {{humanSending ? 'disabled' : ''}}" bindtap="submitHuman">
          {{humanSending ? '提交中…' : '提交工单'}}
        </view>
      </view>
    </view>
  </view>
</view>
