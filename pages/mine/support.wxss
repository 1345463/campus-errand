/* 智能客服页：自定义导航 + 会话区内部纵向排列。
   这一版是第四次重写，把前几轮所有踩过的坑一次性绕开：
   ① 整页不滚动（height:100vh + overflow:hidden），只有中间的 scroll-view 滚；
   ② scroll-view 的高度给死成像素（JS 算好写进内联 style），不用 flex:1、不用 auto ——
      flex 子项高度各基础库不一致，auto 又会被内容撑开，两者都导致"滚到底"落点错位；
   ③ 输入区回文档流（flex:none），不固定、不预留底部空白 ——
      固定输入区 + 底部留白那一版就是"中间空一大截"的来源。
   ④ 消息之间不留大间距，气泡用 pre-wrap 但文本已由 tidyText 清洗过空行。 */

.support-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  /* .page 默认给了底部留白，这页整块撑满，留白交给会话区自己 */
  padding-bottom: 0;
  background: var(--bg);
}

/* 会话区用绝对定位把 top/bottom 交给导航条和屏幕底，
   高度永远等于「导航条以下到屏幕底」，不受父级 padding 影响。 */
.sup-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ---------- 调试条（临时）---------- */
.sup-debug {
  flex: none;
  padding: 6rpx 24rpx;
  background: #FFF4E5;
  color: #B45309;
  font-size: 22rpx;
  text-align: center;
}

/* ---------- 热门问题 ---------- */
.sup-hot {
  flex: none;
  padding: 16rpx 24rpx 18rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--fill);
}

.sup-hot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-hot-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t1);
}

.sup-hot-toggle {
  font-size: 24rpx;
  color: var(--brand);
}

.sup-hot-scroll {
  margin-top: 14rpx;
  width: 100%;
  white-space: nowrap;
}

.sup-hot-row {
  display: inline-flex;
  align-items: center;
}

.sup-hot-chip {
  flex: none;
  margin-right: 14rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-50);
  border: 1rpx solid var(--brand-100);
  font-size: 24rpx;
  color: var(--brand-600);
}

/* ---------- 会话滚动区 ---------- */
/* 高度由内联 style 给死成像素。这里只给宽度和盒模型。
   别加 height / min-height / flex —— 会让内联高度失效。 */
.sup-scroll {
  width: 100%;
  box-sizing: border-box;
}

/* 消息层：从顶部往下排，不要 height / min-height / flex-end，
   否则消息会被顶到可视区外、上面留一片空白（踩过）。 */
.sup-chat {
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}

/* 滚动锚点：必须有布局盒，scroll-into-view 才找得到 */
.chat-end {
  height: 1rpx;
}

.msg-row {
  display: flex;
  flex-direction: column;
  /* 消息之间只留一道窄缝，视觉上才连贯 */
  margin-bottom: 16rpx;
}

.msg-row.mine {
  align-items: flex-end;
}

.msg-row.peer {
  align-items: flex-start;
}

.msg-bubble {
  max-width: 78%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  /* pre-wrap 保留模型输出里的换行；空行已由 tidyText 压掉，不会虚高 */
  white-space: pre-wrap;
  word-break: break-all;
}

.msg-row.peer .msg-bubble {
  background: #FFFFFF;
  color: var(--t1);
  border-top-left-radius: 6rpx;
}

.msg-row.mine .msg-bubble {
  background: var(--brand);
  color: #FFFFFF;
  border-top-right-radius: 6rpx;
}

/* 流式回答过程中气泡是同一个，加一点呼吸感，别看着像卡死 */
.msg-bubble.pending {
  opacity: 0.75;
}

.msg-tag {
  margin-top: 6rpx;
  padding: 0 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--t3);
}

.msg-tag.warn {
  color: var(--warn);
}

/* ---------- 输入区 ---------- */
/* flex: none 钉在文档流底部，跟着会话区一起排。
   别改回 position: fixed —— 那样必须在下面垫一块等高的留白，
   留白算不准就是一整块空白（就是用户说的"中间空一大截"）。 */
.sup-input {
  flex: none;
  padding: 14rpx 24rpx 24rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--fill);
}

.sup-quota {
  font-size: 22rpx;
  color: var(--t3);
  margin-bottom: 10rpx;
}

.sup-quota.dim {
  color: var(--t3);
}

.sup-input-row {
  display: flex;
}

.sup-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  max-height: 220rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--fill);
  font-size: 28rpx;
  color: var(--t1);
}

.sup-send-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-human {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--t2);
}

.sup-count {
  font-size: 22rpx;
  color: var(--t3);
}

.sup-send {
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 28rpx;
}

.sup-send.disabled {
  background: var(--line);
  color: var(--t3);
}

/* ---------- 转人工面板 ---------- */
.sup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(19, 26, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sup-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 28rpx 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #FFFFFF;
}

.sup-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}

.sup-panel-desc {
  margin: 12rpx 0 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--t2);
}

.sup-panel-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-panel-cancel {
  width: 240rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  text-align: center;
  font-size: 28rpx;
  color: var(--t2);
}

.sup-panel-ok {
  width: 380rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: var(--brand);
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
}

.sup-panel-ok.disabled {
  background: var(--line);
  color: var(--t3);
}
