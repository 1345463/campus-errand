/* 智能客服页：整页滚动 + 固定输入区。
   彻底不用 scroll-view 滚消息 —— 它的内容高度在各基础库上算不准，
   五轮修复都没治住（内容被撑到 1053px 而消息只有 302px）。
   整页滚动最简单也最可靠：内容多高页面就多高，pageScrollTo 直接滚到底。
   输入区 position:fixed 钉在屏幕底，消息从它上面滚过；
   会话内容用 padding-bottom 腾出空间，值由 JS 按输入区实测高度给。 */

.support-page {
  min-height: 100vh;
  box-sizing: border-box;
  /* .page 默认有底部留白，这页用固定输入区，留白交给 sup-chat 的 padding-bottom */
  padding-bottom: 0;
  background: var(--bg);
}

/* ---------- 热门问题 ---------- */
.sup-hot {
  padding: 16rpx 24rpx 18rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--fill);
}

.sup-hot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-hot-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t1);
}

.sup-hot-toggle {
  font-size: 24rpx;
  color: var(--brand);
}

.sup-hot-scroll {
  margin-top: 14rpx;
  width: 100%;
  white-space: nowrap;
}

.sup-hot-row {
  display: inline-flex;
  align-items: center;
}

.sup-hot-chip {
  flex: none;
  margin-right: 14rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-50);
  border: 1rpx solid var(--brand-100);
  font-size: 24rpx;
  color: var(--brand-600);
}

/* ---------- 会话内容 ---------- */
/* 普通块级容器，消息从上往下排，内容高度 = 消息实际高度之和。
   别加 height / min-height / flex / justify-content —— 这些是之前
   "内容被撑到 1053px、消息之间空一大截" 的根源。
   padding-bottom 由内联 style 给（输入区高度 + 余量）。 */
.sup-chat {
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.msg-row.mine {
  align-items: flex-end;
}

.msg-row.peer {
  align-items: flex-start;
}

.msg-bubble {
  max-width: 78%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  /* pre-wrap 保留模型输出里的换行；空行已由 tidyText 压掉 */
  white-space: pre-wrap;
  word-break: break-all;
}

.msg-row.peer .msg-bubble {
  background: #FFFFFF;
  color: var(--t1);
  border-top-left-radius: 6rpx;
}

.msg-row.mine .msg-bubble {
  background: var(--brand);
  color: #FFFFFF;
  border-top-right-radius: 6rpx;
}

/* 流式回答过程中气泡是同一个，加一点呼吸感 */
.msg-bubble.pending {
  opacity: 0.75;
}

.msg-tag {
  margin-top: 6rpx;
  padding: 0 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--t3);
}

.msg-tag.warn {
  color: var(--warn);
}

/* ---------- 输入区 ---------- */
/* position:fixed 钉在屏幕底部。z-index 10：比内容高、比转人工弹层(20)低。
   textarea 在 fixed 容器里，auto-height + adjust-position 配合键盘弹起。 */
.sup-input {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 14rpx 24rpx 24rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--fill);
}

.sup-quota {
  font-size: 22rpx;
  color: var(--t3);
  margin-bottom: 10rpx;
}

.sup-quota.dim {
  color: var(--t3);
}

.sup-input-row {
  display: flex;
}

.sup-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  max-height: 220rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--fill);
  font-size: 28rpx;
  color: var(--t1);
}

.sup-send-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-human {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--t2);
}

.sup-count {
  font-size: 22rpx;
  color: var(--t3);
}

.sup-send {
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 28rpx;
}

.sup-send.disabled {
  background: var(--line);
  color: var(--t3);
}

/* ---------- 转人工面板 ---------- */
.sup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(19, 26, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sup-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 28rpx 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #FFFFFF;
}

.sup-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}

.sup-panel-desc {
  margin: 12rpx 0 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--t2);
}

.sup-panel-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-panel-cancel {
  width: 240rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  text-align: center;
  font-size: 28rpx;
  color: var(--t2);
}

.sup-panel-ok {
  width: 380rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: var(--brand);
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
}

.sup-panel-ok.disabled {
  background: var(--line);
  color: var(--t3);
}

.sup-tools { display: flex; justify-content: space-between; padding: 16rpx 24rpx; color: var(--brand); font-size: 24rpx; }
.sup-actions { display: flex; gap: 24rpx; margin-top: 10rpx; color: var(--brand); font-size: 22rpx; }
.sup-warning { color: var(--warn); font-size: 22rpx; padding-top: 8rpx; }
