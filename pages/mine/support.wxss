/* 智能客服页：自定义导航 + 会话区在文档流里、输入区固定在底部。
   滚动交给页面本身（wx.pageScrollTo），不再用 scroll-view ——
   scroll-view 在这个页面上踩了四轮坑：scroll-into-view 滚空、
   scroll-top 塞大数会把内容顶上去留一片空白、flex 子项高度各基础库不一致、
   height:auto 被内容撑开导致 flex-grow 失效。页面滚动没有这些问题，
   而且超过最大可滚距离时框架会自己夹取，不会出现「滚过头」的空白。 */

.support-page {
  position: relative;
  /* 用 min-height：内容少时铺满一屏，内容多时自然撑高，页面才能滚起来 */
  min-height: 100vh;
  box-sizing: border-box;
  /* .page 默认给了底部留白，这里由会话区自己算（要避开固定输入区） */
  padding-bottom: 0;
  background: var(--bg);
}

/* 会话区正常文档流，底部留白由 JS 按输入区实测高度填（见 support.js 的 bodyPad），
   少了最后一条会被压住，多了又是用户眼里的一片空白 —— 所以必须量。 */
.sup-body {
  position: relative;
  box-sizing: border-box;
}

/* ---------- 热门问题 ---------- */
.sup-hot {
  flex: none;
  padding: 16rpx 24rpx 18rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--fill);
}

.sup-hot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-hot-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t1);
}

.sup-hot-toggle {
  font-size: 24rpx;
  color: var(--brand);
}

.sup-hot-scroll {
  margin-top: 14rpx;
  width: 100%;
  white-space: nowrap;
}

.sup-hot-row {
  display: inline-flex;
  align-items: center;
}

.sup-hot-chip {
  flex: none;
  margin-right: 14rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-50);
  border: 1rpx solid var(--brand-100);
  font-size: 24rpx;
  color: var(--brand-600);
}

/* ---------- 会话区 ---------- */
/* 会话内容层：消息从顶部往下排。
   别给它设 height / min-height / flex，更别用 justify-content:flex-end
   想把消息顶到底部 —— 那需要容器有确定高度，页面滚动时没有这个参照，
   结果就是消息被推到可视区外、上面留一大片空白。 */
.sup-chat {
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}

/* 临时调试条，确认完删除。
   用 fixed 而不是文档流：页面会滚到底，文档流里的调试条一滚就没影了。
   top 由行内样式给（要避开自定义导航条）。 */
.sup-debug {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 30;
  padding: 8rpx 24rpx;
  background: #FFF4E5;
  color: #B45309;
  font-size: 22rpx;
  text-align: center;
}

.msg-row {
  display: flex;
  flex-direction: column;
  /* 消息之间只留一道窄缝，视觉上才连贯 */
  margin-bottom: 16rpx;
}

.msg-row.mine {
  align-items: flex-end;
}

.msg-row.peer {
  align-items: flex-start;
}

.msg-bubble {
  max-width: 78%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}

.msg-row.peer .msg-bubble {
  background: #FFFFFF;
  color: var(--t1);
  border-top-left-radius: 6rpx;
}

.msg-row.mine .msg-bubble {
  background: var(--brand);
  color: #FFFFFF;
  border-top-right-radius: 6rpx;
}

/* 流式回答过程中气泡是同一个，加一点呼吸感，别看着像卡死 */
.msg-bubble.pending {
  opacity: 0.75;
}

.msg-tag {
  margin-top: 6rpx;
  padding: 0 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--t3);
}

.msg-tag.warn {
  color: var(--warn);
}

/* ---------- 输入区 ---------- */
/* 固定在视口底部：放在文档流里会随历史消息一起滚走。
   z-index 要低于转人工弹层（20），弹层才能盖住它。 */
.sup-input {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 12;
  box-sizing: border-box;
  padding: 14rpx 24rpx 24rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--fill);
}

.sup-quota {
  font-size: 22rpx;
  color: var(--t3);
  margin-bottom: 10rpx;
}

.sup-quota.dim {
  color: var(--t3);
}

.sup-input-row {
  display: flex;
}

.sup-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  max-height: 220rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--fill);
  font-size: 28rpx;
  color: var(--t1);
}

.sup-send-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-human {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--t2);
}

.sup-count {
  font-size: 22rpx;
  color: var(--t3);
}

.sup-send {
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 28rpx;
}

.sup-send.disabled {
  background: var(--line);
  color: var(--t3);
}

/* ---------- 转人工面板 ---------- */
.sup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(19, 26, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sup-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 28rpx 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #FFFFFF;
}

.sup-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}

.sup-panel-desc {
  margin: 12rpx 0 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--t2);
}

.sup-panel-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sup-panel-cancel {
  width: 240rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  text-align: center;
  font-size: 28rpx;
  color: var(--t2);
}

.sup-panel-ok {
  width: 380rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: var(--brand);
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
}

.sup-panel-ok.disabled {
  background: var(--line);
  color: var(--t3);
}
