<view class="page">
  <view wx:if="{{needLogin}}" class="empty">
    <view>登录后才能查看钱包</view>
    <view class="btn-primary top-gap" bindtap="goLogin">去登录</view>
  </view>

  <view wx:elif="{{loading}}" class="empty">加载中…</view>

  <view wx:else>
    <view class="hero">
      <view class="hero-title">¥ {{balance}}</view>
      <view class="hero-sub">{{nickname}} 的钱包余额</view>
    </view>

    <view class="card">
      <view class="btn-ghost" bindtap="goAccepted">查看我接的单</view>
    </view>

    <view class="card">
      <view class="section-head">
        <text class="section-title">余额明细</text>
      </view>
      <view wx:if="{{records.length === 0}}" class="hint">还没有余额变动记录</view>
      <view wx:else>
        <view class="detail-row wd-row" wx:for="{{records}}" wx:for-item="rec" wx:key="id">
          <view class="detail-label wd-label">
            <text class="wd-kind">{{rec.kindText}}</text>
            <text class="wd-sub">{{rec.timeText}}</text>
            <text wx:if="{{rec.remark}}" class="wd-sub wd-remark">{{rec.remark}}</text>
          </view>
          <view class="detail-value wd-value {{rec.positive ? 'flow-plus' : 'flow-minus'}}">
            ¥{{rec.deltaText}}
            <text class="wd-sub">（余 {{rec.balanceText}}）</text>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="empty">加载中…</view>
        <view wx:elif="{{!hasMore}}" class="empty">没有更多了</view>
      </view>
    </view>

    <view class="card">
      <view class="section-head">
        <text class="section-title">说明</text>
      </view>
      <view class="hint" wx:for="{{notes}}" wx:key="*this">{{index + 1}}. {{item}}</view>
    </view>

    <view class="card">
      <view class="section-head">
        <text class="section-title">提现</text>
        <text class="section-more" bindtap="refreshWithdraw">{{wdRefreshing ? '刷新中…' : '刷新'}}</text>
      </view>

      <view wx:if="{{wdErr}}" class="err-bar">
        <text class="err-text">{{wdErr}}</text>
        <text class="err-retry" bindtap="refreshWithdraw">重试</text>
      </view>

      <view wx:elif="{{wdLoading && !wdReady}}" class="hint">加载中…</view>

      <view wx:else>
        <view wx:if="{{wdClaim}}" class="note-box">
          <view class="detail-label">有一笔转账待你确认收款</view>
          <view class="detail-value">¥{{wdClaim.amountText}}</view>
          <view class="hint">点下面按钮确认后才会到微信零钱；24 小时不确认会自动退回</view>
          <view class="btn-primary top-gap" bindtap="claimTransfer">确认收款</view>
        </view>

        <view class="detail-row">
          <view class="detail-label">可提现余额</view>
          <view class="detail-value">¥{{wdBalanceText}}</view>
        </view>
        <view class="detail-row">
          <view class="detail-label">最低提现</view>
          <view class="detail-value">¥{{wdMinText}}</view>
        </view>

        <view class="note-box">
          <input
            class="note-input"
            placeholder-class="field-ph"
            placeholder="输入提现金额"
            type="digit"
            value="{{wdAmount}}"
            bindinput="onAmountInput"
          />
          <view class="btn-row">
            <view class="btn-ghost half" bindtap="useAll">全部提现</view>
            <view
              class="btn-primary half {{wdSubmitting ? 'disabled' : ''}}"
              bindtap="submitWithdraw"
            >{{wdSubmitting ? '提交中…' : '申请提现'}}</view>
          </view>
        </view>

        <view wx:if="{{wdRecords.length > 0}}">
          <view class="section-head">
            <text class="section-title">提现记录</text>
          </view>
          <view
            class="detail-row"
            wx:for="{{wdRecords}}"
            wx:for-item="wr"
            wx:key="id"
          >
            <view class="detail-label">
              <text class="flow-time">{{wr.timeText}}</text>
              <text wx:if="{{wr.failReason}}" class="flow-time">{{wr.failReason}}</text>
            </view>
            <view class="detail-value">
              ¥{{wr.amountText}}
              <text class="flow-time"> {{wr.statusText}}</text>
            </view>
          </view>
        </view>

        <view class="hint top-gap">
          提现由系统自动转账到微信零钱，到账后在「我的」页会收到通知
        </view>
      </view>
    </view>
  </view>
</view>
