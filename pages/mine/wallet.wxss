/* 我的钱包：余额明细 */

.flow-kind {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
}

.flow-time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--t3);
}

/* 余额明细行：全局 .detail-label 是固定 180rpx，长文本会溢出压到右侧金额上
   （出现过 withdraw_refund 这类英文原值把 ¥10.00 盖住的情况），这里覆盖成
   左侧自适应收缩 + 右侧金额不参与压缩。 */
.wd-row {
  align-items: flex-start;
}
.wd-label {
  flex: 1;
  width: auto;
  min-width: 0;
  padding-right: 20rpx;
}
.wd-kind {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.wd-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--t3);
}
.wd-remark {
  word-break: break-all;
}
.wd-value {
  flex: none;
  width: auto;
  max-width: 46%;
  text-align: right;
  word-break: normal;
}

/* 收入用主题色，支出用中性灰 */
.flow-plus {
  color: var(--brand);
  font-weight: 600;
}

.flow-minus {
  color: var(--t2);
  font-weight: 600;
}
