/* 订单进度时间轴 */

.tl {
  padding-left: 8rpx;
}

.tl-item {
  position: relative;
  padding: 0 0 32rpx 40rpx;
  /* 用左侧竖线把节点串起来 */
  border-left: 2rpx solid #E6E7EA;
}

/* 最后一项不画竖线，避免出现一段悬空的线尾 */
.tl-item.last {
  border-left-color: transparent;
  padding-bottom: 0;
}

.tl-dot {
  position: absolute;
  left: -9rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF5A7A;
}

.tl-body {
  margin-top: -4rpx;
}

.tl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2023;
}

.tl-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6B6B70;
}

.tl-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9A9CA1;
}
