/* 订单列表：搜索框 */

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 36rpx;
  background: var(--fill);
  font-size: 28rpx;
  color: var(--t1);
}

.search-btn {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 28rpx;
}

.search-clear {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--t3);
}
